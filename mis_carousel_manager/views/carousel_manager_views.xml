<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="mis_carousel_manager_view_list" model="ir.ui.view">
            <field name="name">mis.carousel.manager.list</field>
            <field name="model">mis.carousel.manager</field>
            <field name="arch" type="xml">
                <list string="Carousel">
                    <field name="sequence" widget="handle" />
                    <field name="name"/>
                    <field name="image_url"/>
                    <field name="content"/>
                </list>
            </field>
        </record>

        <record id="mis_carousel_manager_view_form" model="ir.ui.view">
            <field name="name">mis.carousel.manager.form</field>
            <field name="model">mis.carousel.manager</field>
            <field name="arch" type="xml">
                <form string="Carousel">
                    <sheet>
                        <group>
                            <group name="Carousel Info" string="Carousel Info">
                                <field name="sequence" />
                                <field name="name"/>
                                <field name="content"/>
                                <field name="image"/>
                                <field name="image_url" widget="website_urls"/>
                            </group>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <record model="ir.actions.act_window" id="mis_carousel_manager_action_window">
            <field name="name">Carousel Manager</field>
            <field name="res_model">mis.carousel.manager</field>
            <field name="view_mode">list,form</field>
        </record>
        <menuitem name="Carousel Manager" id="mis_carousel_manager" action="mis_carousel_manager_action_window" parent="va_mis.mis_config_menu" sequence="1"/>
    </data>
</odoo>
