<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_partner_inherit_mis_tickets" model="ir.ui.view">
        <field name="name">res.partner.inherits.form.mis_tickets</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form" />
        <field name="arch" type="xml">
            <data>
                <xpath expr="//page[@name='contact_addresses']" position="before">
                    <page string="Tickets" name="tickets">
                        <field name="ticket_ids" />
                    </page>
                </xpath>
            </data>
        </field>
    </record>
</odoo>
