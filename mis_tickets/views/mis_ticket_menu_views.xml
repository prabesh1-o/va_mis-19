<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record model="ir.ui.view" id="mis_tickets_menu_list">
            <field name="name">mis.ticket.menu.list</field>
            <field name="model">mis.ticket.menu</field>
            <field name="arch" type="xml">
                <list string="Devices">
                    <field name="name"/>
                    <field name="user_id"/>
                    <field name="date_start" string="Start Date"/>
                    <field name="date" string="End Date"/>
                    <field name="priority" widget="priority"/>
                </list>
            </field>
        </record>

        <record id="mis_tickets_menu_form" model="ir.ui.view">
            <field name="name">mis.ticket.menu.form</field>
            <field name="model">mis.ticket.menu</field>
            <field name="arch" type="xml">
                <form string="Tickets">
                    <sheet string="Tickets">
                        <div class="oe_title">
                            <h1 class="d-flex flex-row">
                                <field name="priority" nolabel="1" widget="boolean_favorite" class="me-2"/>
                                <field name="name" class="o_text_overflow" placeholder="e.g. Title"/>
                            </h1>
                        </div>
                        <group>
                            <group>
                                <field name="tag_ids" widget="many2many_tags" options="{'color_field': 'color'}"/>
                            </group>
                            <group>
                                <field name="user_id" widget="many2one_avatar_user"/>
                                <label for="date_start" string="Planned Date"/>
                                <div name="dates" class="o_row">
                                    <field name="date_start" widget="daterange" options='{"related_end_date": "date"}'/>
                                    <i class="fa fa-long-arrow-right mx-2 oe_edit_only" aria-label="Arrow icon" title="Arrow"/>
                                    <i class="fa fa-long-arrow-right mx-2 oe_read_only" aria-label="Arrow icon" title="Arrow" invisible="not (date_start and date)"/>
                                    <field name="date" widget="daterange" options='{"related_start_date": "date_start"}'/>
                                </div>
                            </group>
                        </group>
                        <notebook>
                            <page name="description" string="Description">
                                <field name="description" options="{'resizable': false}" placeholder="Project description..."/>
                            </page>
                        </notebook>
                    </sheet>
                    <!-- Chatter -->
                    <chatter>
                        <field name="message_follower_ids" groups="base.group_user"/>
                        <field name="activity_ids"/>
                        <field name="message_ids"/>
                    </chatter>
                </form>
            </field>
        </record>

        <record model="ir.ui.view" id="mis_ticket_menu_kanban">
            <field name="name">mis.ticket.menu.kanban</field>
            <field name="model">mis.ticket.menu</field>
            <field name="arch" type="xml">
                <kanban class="oe_background_grey o_kanban_dashboard o_project_kanban o_emphasize_colors" action="action_view_tickets" type="object" sample="1" default_order="priority desc, id desc, sequence">
                    <field name="name"/>
                    <field name="color"/>
                    <field name="ticket_count"/>
                    <field name="date"/>
                    <field name="tag_ids"/>
                    <field name="sequence" widget="handle"/>
                    <templates>
                        <t t-name="card">
                            <div t-attf-class="oe_kanban_color_{{ record.color.raw_value }} oe_kanban_card">
                                <div class="o_project_kanban_main ">
                                    <div class="o_kanban_card_content mw-100">
                                        <div class="o_kanban_primary_left">

                                            <div class="o_primary">
                                                <span class="o_text_overflow" t-att-title="record.name.value">
                                                    <t t-esc="record.name.value"/>
                                                </span>

                                                <div t-if="record.date.raw_value or record.date_start.raw_value" class="text-muted o_row">
                                                    <span class="fa fa-clock-o me-2" title="Dates"></span>
                                                    <field name="date_start"/>
                                                    <i t-if="record.date.raw_value and record.date_start.raw_value" class="fa fa-long-arrow-right mx-2 oe_read_only" aria-label="Arrow icon" title="Arrow"/>
                                                    <field name="date"/>
                                                </div>
                                                <field name="tag_ids" widget="many2many_tags" options="{'color_field': 'color'}"/>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="o_kanban_card_manage_pane dropdown-menu" role="menu">
                                        <div class="o_kanban_slides_card_manage_pane p-4">
                                            <t t-if="widget.deletable">
                                                <div role="menuitem">
                                                    <a type="delete">Delete</a>
                                                </div>
                                            </t>
                                            <div role="menuitem">
                                                <a role="menuitem" type="open">View</a>
                                            </div>
                                            <div role="menuitem">
                                                <a name="action_view_tickets" type="object">Tasks</a>
                                            </div>
                                            <div role="separator" class="dropdown-divider"></div>
                                        </div>
                                        <div role="menuitem" aria-haspopup="true" class="o_no_padding_kanban_colorpicker">
                                            <ul class="oe_kanban_colorpicker" data-field="color" role="popup" />
                                        </div>
                                    </div>
                                    <a class="o_kanban_manage_toggle_button o_dropdown_kanban" href="#" groups="base.group_user">
                                        <i class="fa fa-ellipsis-v" role="img" aria-label="Manage" title="Manage"/>
                                    </a>
                                </div>
                                <div class="o_kanban_record_bottom mt-3">
                                    <div class="oe_kanban_bottom_left">
                                        <field name="priority" widget="priority"/>
                                        <div class="o_project_kanban_boxes d-flex align-items-baseline">
                                            <a class="o_project_kanban_box" name="action_view_tickets" type="object">
                                                <div>
                                                    <span class="o_value">
                                                        <t t-esc="record.ticket_count.value"/>
                                                    </span>
                                                    <span class="o_label ms-1">Tickets</span>
                                                </div>
                                            </a>
                                        </div>
                                    </div>
                                    <div class="oe_kanban_bottom_right">
                                        <field name="user_id" widget="many2one_avatar_user" t-if="record.user_id.raw_value"/>
                                    </div>
                                </div>
                            </div>
                        </t>
                    </templates>
                </kanban>
            </field>
        </record>

        <record model="ir.ui.view" id="mis_tickets_menu_search">
            <field name="name">mis.tickets.menu.search</field>
            <field name="model">mis.ticket.menu</field>
            <field name="arch" type="xml">
                <search string="Ticket Menu">
                    <filter name="filter_menu_active" string="Active" domain="[('active', '=', True)]"/>
                </search>
            </field>
        </record>

        <record model="ir.actions.act_window" id="mis_tickets_menu_action_window">
            <field name="name">Tickets Menu</field>
            <field name="res_model">mis.ticket.menu</field>
            <field name="view_mode">kanban,list,form</field>
            <field name="context">{'active_test': False, 'search_default_filter_menu_active': 1}</field>
        </record>

        <menuitem name="Complaints" id="mis_tickets_menu_menu" parent="va_mis.mis_root_menu" action="mis_tickets_menu_action_window" sequence="2"/>
    </data>
</odoo>
