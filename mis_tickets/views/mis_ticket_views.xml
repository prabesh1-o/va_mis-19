<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record model="ir.ui.view" id="mis_tickets_list">
            <field name="name">mis.tickets.list</field>
            <field name="model">mis.ticket</field>
            <field name="arch" type="xml">
                <list js_class="button_in_list" string="Devices" multi_edit="1" export_xlsx="false">
                    <field name="ticket_id"/>
                    <field name="customer_id"/>
                    <field name="device_imei" optional="hide"/>
                    <field name="employee_ids" widget="many2many_avatar_user" />
                    <field name="ticket_menu_id" invisible="1"/>
                    <field name="stage_id" optional="hide"/>
                    <field name="description" optional="hide"/>
                    <field name="issue_reporter" optional="hide"/>
                    <field name="tag_ids" widget="many2many_tags" optional="hide"/>
                </list>
            </field>
        </record>

        <record model="ir.ui.view" id="mis_tickets_form">
            <field name="name">mis.ticket.form</field>
            <field name="model">mis.ticket</field>
            <field name="arch" type="xml">
                <form string="Form">
                    <header>
                        <button name="action_assign_to_me" type="object">Assign To Me</button>
                        <field name="stage_id" widget="statusbar" class="o_field_statusbar" options="{'clickable': '1', 'fold_field': 'fold'}" invisible="not (ticket_menu_id and stage_id)"/>
                    </header>
                    <sheet>
                        <group col="2">
                            <group>
                                <field name="create_date" invisible="1"/>
                                <field name="ticket_id" readonly="1" invisible="not create_date"/>
                                <field name="employee_ids" widget="many2many_avatar_user" />
                                <field name="tag_ids" widget="many2many_tags" options="{'color_field': 'color'}"/>
                            </group>
                            <group>
                                <field name="ticket_menu_id"/>
                                <field name="customer_id"/>
                                <field name="device_imei"/>
                                <field name="color" invisible="1"/>
                                <field name="priority"/>
                            </group>
                        </group>
                        <div class="d-flex col-12">
                            <strong class="text-dark w-50">Issue Reporter(Name and Contact No.)</strong>
                            <field name="issue_reporter"/>
                        </div>
                        <group>
                            <field name="description"/>
                        </group>
                    </sheet>
                    <!-- Chatter -->
                    <chatter>
                        <field name="message_follower_ids" groups="base.group_user"/>
                        <field name="activity_ids"/>
                        <field name="message_ids"/>
                    </chatter>
                </form>
            </field>
        </record>

        <record model="ir.ui.view" id="quick_create_ticket_form">
            <field name="name">mis.ticket.quick.form</field>
            <field name="model">mis.ticket</field>
            <field name="arch" type="xml">
                <form string="Form">
                    <group>
                        <field name="ticket_id" readonly="1" invisible="1"/>
                        <field name="customer_id"/>
                        <field name="tag_ids" widget="many2many_tags"/>
                        <field name="description"/>
                        <field name="issue_reporter"/>
                        <field name="priority"/>
                        <field name="color" invisible="1"/>
                        <field name="employee_ids" widget="many2many_tags" invisible="1"/>
                    </group>
                </form>
            </field>
        </record>

        <record model="ir.ui.view" id="mis_ticket_kanban_view">
            <field name="name">mis.ticket.kanban</field>
            <field name="model">mis.ticket</field>
            <field name="arch" type="xml">
                <kanban js_class="button_in_kanban" default_group_by="stage_id" class="o_kanban_small_column o_kanban_project_tasks" on_create="quick_create" quick_create_view="mis_tickets.quick_create_ticket_form" sample="1">
                    <field name="color"/>
                    <field name="priority"/>
                    <field name="stage_id" options='{"group_by_tooltip": {"requirements": "Requirements"}}'/>
                    <progressbar field="kanban_state" colors='{"done": "success", "blocked": "danger", "normal": "200","warning":"warning"}'/>
                    <templates>
                        <t t-name="card">
                            <div t-attf-class="{{!selection_mode ? 'oe_kanban_color_' + record.color.raw_value : ''}} oe_kanban_card oe_kanban_global_click">
                                <div class="oe_kanban_content">
                                    <div class="o_kanban_record_top">
                                        <div class="o_kanban_record_headings">
                                            <div class="text-muted">
                                                <field name ="ticket_id"/>
                                            </div>
                                            <strong class="o_kanban_record_title" name="customer_section">
                                                <field name="customer_id"/>
                                            </strong>
                                            <span invisible="context.get('default_ticket_menu_id', False)">
                                                <br/>
                                                <field name="ticket_menu_id" options="{'no_open': True}"/>
                                            </span>
                                        </div>
                                        <div class="o_dropdown_kanban dropdown" t-if="!selection_mode" groups="base.group_user">
                                            <a role="button" class="dropdown-toggle o-no-caret btn" data-bs-toggle="dropdown" data-bs-display="static" href="#" aria-label="Dropdown menu" title="Dropdown menu">
                                                <span class="fa fa-ellipsis-v"/>
                                            </a>
                                            <div class="dropdown-menu" role="menu">
                                                <a t-if="widget.editable" role="menuitem" type="edit" class="dropdown-item">Edit</a>
                                                <a t-if="widget.deletable" role="menuitem" type="delete" class="dropdown-item">Delete</a>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="o_kanban_record_body">
                                        <field name="tag_ids" widget="many2many_tags" options="{'color_field': 'color'}"/>
                                    </div>
                                    <div class="o_kanban_record_bottom" t-if="!selection_mode">
                                        <div class="oe_kanban_bottom_left">
                                        </div>
                                        <div class="oe_kanban_bottom_right" t-if="!selection_mode">
                                            <field name="kanban_state" widget="state_selection"/>
                                            <t t-if="record.employee_ids.raw_value">
                                                <field name="employee_ids" widget="many2many_avatar_user"/>
                                            </t>
                                        </div>
                                    </div>
                                </div>
                                <div class="clearfix"></div>
                            </div>
                        </t>
                    </templates>
                </kanban>
            </field>
        </record>

        <record id="mis_tickets_search" model="ir.ui.view">
            <field name="name">mis.ticket.view.search</field>
            <field name="model">mis.ticket</field>
            <field name="arch" type="xml">
                <search>
                    <field name="ticket_id" string="Ticket ID"/>
                    <field name="customer_id" string="Customer"/>
                    <field name="device_imei"/>
                    <filter name="employee_ids" string="My Tickets" domain="[('employee_ids','in',uid)]" />
                    <filter name="create_date" string="Today's Tickets" domain="[('create_date','&gt;', (context_today() - datetime.timedelta(days=1)).strftime('%Y-%m-%d'))]" />
                    <separator />
                    <filter invisible="1" string="Late Activities" name="activities_overdue" domain="[('my_activity_date_deadline', '&lt;', context_today().strftime('%Y-%m-%d'))]" />
                    <filter invisible="1" string="Today Activities" name="activities_today" domain="[('my_activity_date_deadline', '=', context_today().strftime('%Y-%m-%d'))]" />
                    <filter invisible="1" string="Future Activities" name="activities_upcoming_all" domain="[('my_activity_date_deadline', '&gt;', context_today().strftime('%Y-%m-%d'))]" />
                    <separator />
                </search>
            </field>
        </record>

        <record id="mis_ticket_graph" model="ir.ui.view">
            <field name="name">mis.ticket.graph</field>
            <field name="model">mis.ticket</field>
            <field name="arch" type="xml">
                <graph string="Tickets" sample="1">
                    <field name="customer_id"/>
                </graph>
            </field>
        </record>

        <record id="action_view_all_ticket_views" model="ir.actions.act_window">
            <field name="name">Tickets</field>
            <field name="res_model">mis.ticket</field>
            <field name="view_mode">kanban,list,graph,form</field>
            <field name="domain">[('ticket_menu_id', '=', active_id)]</field>
            <field name="context">{
                'default_ticket_menu_id': active_id,
            }</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    No tickets found. Let's create one!
                </p>
                <p>
                    Keep track of the progress of your tickets from creation to completion.<br/>
                    Collaborate efficiently by chatting in real-time or via email.
                </p>
            </field>
        </record>
    </data>
</odoo>
