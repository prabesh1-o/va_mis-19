<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record model="ir.module.category" id="mis_ticket_management_parent">
        <field name="name">MIS Ticket</field>
        <field name="description">MIS Ticket related modules</field>
        <field name="sequence">11</field>
    </record>

    <record model="ir.module.category" id="mis_ticket_management">
        <field name="name">MIS Ticket</field>
        <field name="description">MIS ticket</field>
        <field name="parent_id" ref="mis_ticket_management_parent" />
    </record>

    <record id="privilege_mis_ticket_management" model="res.groups.privilege">
        <field name="name">MIS Ticket</field>
        <field name="category_id" ref="mis_ticket_management"/>
        <field name="sequence">10</field>
    </record>


    <!-- User: Own Documents Only -->
    <record id="group_mis_ticket_user_readonly" model="res.groups">
        <field name="name">User: Read Only</field>
        <field name="privilege_id" ref="privilege_mis_ticket_management" />
        <field name="comment">The user will have readonly access to their records.</field>
    </record>

    <!-- user: own documents -->
    <record id="group_mis_ticket_user_own_documents" model="res.groups">
        <field name="name">User: Own Documents</field>
        <field name="implied_ids" eval="[(4, ref('group_mis_ticket_user_readonly'))]" />
        <field name="privilege_id" ref="privilege_mis_ticket_management" />
        <field name="comment">The user will have create,read,update access to their own records.</field>
    </record>

    <!-- manager  -->
    <record id="group_mis_ticket_all_documents" model="res.groups">
        <field name="name">Manager</field>
        <field name="privilege_id" ref="privilege_mis_ticket_management" />
        <field name="implied_ids" eval="[(4, ref('group_mis_ticket_user_own_documents'))]" />
        <field name="comment">The user will have create,read,update access for all records</field>
    </record>

    <!-- admins -->
    <record id="group_mis_ticket_administrator" model="res.groups">
        <field name="name">Administrator</field>
        <field name="privilege_id" ref="privilege_mis_ticket_management" />
        <field name="implied_ids" eval="[(4, ref('group_mis_ticket_all_documents'))]" />
        <field name="comment">The user will have all access to all records</field>
        <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]" />
    </record>

</odoo>
