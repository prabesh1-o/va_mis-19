<odoo>
    <data noupdate="1">
        <record id="deactivate_old_completed_tickets" model="ir.cron">
            <field name="name">MIS Tickets: Deactivate Old Completed Tickets</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="model_id" ref="model_mis_ticket"/>
            <field name="code">model.hide_completed_tickets()</field>
            <field name="state">code</field>
            <field name="active" eval="True" />
        </record>
    </data>
</odoo>
