<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record model="ir.module.category" id="mis_requirement_collection">
        <field name="name">MIS Requirement Collection</field>
        <field name="description">MIS Requirement Collection Access</field>
    </record>



    <record model="res.groups.privilege" id="privilege_mis_requirement_collection">
        <field name="name">MIS Requirement Collection</field>
        <field name="category_id" ref="mis_requirement_collection"/>
    </record>


    <record id="group_able_to_approve_requirements" model="res.groups">
        <field name="name">Able to Approve Requirements Collection</field>
        <field name="comment">Users can approve the requirements</field>
        <field name="privilege_id" ref="privilege_mis_requirement_collection"/>
        <field name="user_ids" eval="[(4, ref('base.user_admin'))]"/>
    </record>
</odoo>
