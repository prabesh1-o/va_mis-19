<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="mis_requirements_view_list" model="ir.ui.view">
        <field name="name">mis_requirements.view.list</field>
        <field name="model">mis.requirements</field>
        <field name="arch" type="xml">
            <list
                decoration-success="state == 'approved'"
                decoration-warning="state == 'to_approve'"
                decoration-danger="state == 'refused'">
                <field name="title" />
                <field name="requested_by" />
                <field name="department" />
                <field name="state" widget="badge"
                    decoration-success="state == 'approved'"
                    decoration-warning="state == 'to_approve'"
                    decoration-danger="state == 'refused'" />
                <button name="action_approve"
                    type="object"
                    string="Approve"
                    invisible="state != 'to_approve'"
                    class="btn-primary"
                    groups="mis_requirement_collection.group_able_to_approve_requirements"
                />
                <button name="action_refuse"
                    type="object"
                    string="Refuse"
                    invisible="state != 'to_approve'"
                    class="oe-highlight"
                    groups="mis_requirement_collection.group_able_to_approve_requirements"
                />
            </list>
        </field>
    </record>

    <record id="mis_requirement_view_form" model="ir.ui.view">
        <field name="name">mis_requirements.view.form</field>
        <field name="model">mis.requirements</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_approve"
                        string="Approve"
                        type="object"
                        invisible="state != 'to_approve'"
                        class="btn-primary"
                        groups="mis_requirement_collection.group_able_to_approve_requirements"
                    />
                    <button name="action_refuse"
                        string="Refuse"
                        type="object"
                        invisible="state != 'to_approve'"
                        class="oe-highlight"
                        groups="mis_requirement_collection.group_able_to_approve_requirements"
                    />
                    <field name="state" widget="statusbar"
                        statusbar_visible="to_approve,approved,refused" />
                </header>
                <sheet>
                    <group>
                        <field name="title" />
                        <field name="requested_by" />
                        <field name="department" />
                        <field name="description" />
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="mis_requirement_view_search" model="ir.ui.view">
        <field name="name">mis_requirements.view.search</field>
        <field name="model">mis.requirements</field>
        <field name="arch" type="xml">
            <search string="Requirements Search">
                <field name="title" />
                <field name="requested_by" />

                <filter name="to_approve" string="To Approve" domain="[('state', '=', 'to_approve')]"/>
                <filter name="approved" string="Approved" domain="[('state', '=', 'approved')]"/>
                <filter name="refused" string="Refused" domain="[('state', '=', 'refused')]"/>
            </search>
        </field>
    </record>

    <record id="reuirement_collection_action" model="ir.actions.act_window">
        <field name="name">Requirements</field>
        <field name="res_model">mis.requirements</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem
        id="requirement_collection_menu"
        name="Requirements Collection"
        action="reuirement_collection_action"
        parent="va_mis.mis_root_menu"
        sequence="15" />

</odoo>