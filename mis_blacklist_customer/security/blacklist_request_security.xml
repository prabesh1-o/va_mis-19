<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record model="ir.module.category" id="mis_blacklist_customer_management">
        <field name="name">MIS Blacklist Customer</field>
        <field name="description">Mis blacklist customer Access</field>
        <field name="parent_id" ref="mis_customer.mis_customer_management_parent" />
    </record>

    <record id="privilege_mis_blacklist_customer" model="res.groups.privilege">
        <field name="name">MIS Blacklist Customer</field>
        <field name="category_id" ref="mis_blacklist_customer_management"/>
        <field name="sequence">10</field>
    </record>

    <record id="group_mis_blacklist_customer_user" model="res.groups">
        <field name="name">User: Read Only</field>
        <field name="privilege_id" ref="privilege_mis_blacklist_customer" />
        <field name="comment">The user will have read access only</field>
    </record>

    <!-- manager: without delete option -->
    <record id="group_mis_blacklist_customer_manager" model="res.groups">
        <field name="name">Manager</field>
        <field name="privilege_id" ref="privilege_mis_blacklist_customer" />
        <field name="implied_ids"
            eval="[(4, ref('group_mis_blacklist_customer_user'))]" />
        <field name="comment">The user will have create,read,update access to all records</field>
    </record>

    <!-- admin: all access rights -->
    <record id="group_mis_blacklist_customer_administrator" model="res.groups">
        <field name="name">Administrator</field>
       <field name="privilege_id" ref="privilege_mis_blacklist_customer" />
        <field name="implied_ids"
            eval="[(4, ref('group_mis_blacklist_customer_manager'))]" />
        <field name="comment">The user will have all access to all records</field>
    </record>
</odoo>
