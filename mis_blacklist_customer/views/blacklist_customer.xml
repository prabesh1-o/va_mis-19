<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="blacklist_customer_view_list" model="ir.ui.view">
            <field name="name">blacklist.customer.view.list</field>
            <field name="model">mis.blacklist.customer</field>
            <field name="arch" type="xml">
                <list string="Blacklist" decoration-danger="stage == 'request'" decoration-muted="stage == 'approved'" decoration-warning="stage== 'rejected'">
                    <field name="name"/>
                    <field name="customer_id"/>
                    <field name="request_date"/>
                    <field name="requested_by"/>
                    <field name="stage"/>
                </list>
            </field>
        </record>

        <record id="blacklist_customer_view_kanban" model="ir.ui.view">
            <field name="name">blacklist.customer.view.kanban</field>
            <field name="model">mis.blacklist.customer</field>
            <field name="arch" type="xml">
                <kanban string="Blacklist" default_group_by="stage">
                    <templates>
                        <t t-name="card">
                            <div t-attf-class="oe_kanban_card oe_kanban_global_click">
                                <div class="o_kanban_details">
                                    <div>
                                        <strong>
                                            <field name="name"/>
                                        </strong>
                                    </div>
                                    <div>
                                        <h4>
                                            <field name="customer_id"/>
                                        </h4>
                                    </div>
                                    <div>
                                        <field name="request_date"/>
                                    </div>
                                    <div>
                                        <field name="requested_by"/>
                                    </div>
                                </div>
                            </div>
                        </t>
                    </templates>
                </kanban>
            </field>
        </record>


