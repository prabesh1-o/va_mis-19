<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.mis.invoice</field>
        <field name="model">res.config.settings</field>
        <field name="priority" eval="100"/>
        <field name="inherit_id" ref="va_mis.res_config_settings_view_form" />
        <field name="arch" type="xml">
            <xpath expr="//div[@name='mis_config_holder']" position="inside">
                <div class="mis_blacklist_customer">
                    <h2> MIS Blacklist Customer</h2>
                    <div class="row mt16 o_settings_container">
                        <div class="col-12 col-lg-6 o_setting_box">
                            <div class="o_setting_right_pane">
                                <span class="o_form_label">Blacklist request verificator</span>
                                <div class="text-muted">
                                    Enter the employee that verifies blacklist request
                                </div>
                                <div class="content-group">
                                    <div class="mt16">
                                        <field name="verificator" class="o_light_label"/>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="col-12 col-lg-6 o_setting_box">
                            <div class="o_setting_right_pane">
                                <span class="o_form_label">Blacklist request approver</span>
                                <div class="text-muted">
                                    Enter the employee that approves blacklist request
                                </div>
                                <div class="content-group">
                                    <div class="mt16">
                                        <field name="approver" class="o_light_label"/>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </xpath>
        </field>
    </record>
</odoo>
