<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="mis_invoice_tree_inherit" model="ir.ui.view">
            <field name="name">mis.invoice.inherits.tree.inherit</field>
            <field name="model">account.move</field>
            <field name="inherit_id" ref="account.view_move_tree"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='state']" position="after">
                    <field name="npa" widget="boolean_toggle" readonly="1"/>
                </xpath>
            </field>
        </record>

        <record id="mis_invoice_form_inherit" model="ir.ui.view">
            <field name="name">mis.invoice.inherits.invoice</field>
            <field name="model">account.move</field>
            <field name="inherit_id" ref="account.view_move_form"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='narration']" position="before">
                    <field name="note_id"/>
                </xpath>
                <xpath expr="//div[@name='button_box']" position="after">
                    <widget name="web_ribbon" title="NPA" invisible="not npa" bg_color="bg-danger"/>
                    <field name="npa" invisible="1"/>
                </xpath>
                <xpath expr="//field[@name='payment_reference']" position="after">
                    <field name="tag_ids" widget="many2many_tags" options="{'color_field': 'color'}"/>
                    <field name="fiscal_period_id"/>
                    <field name="npa" groups="va_mis.group_mis_admin,va_mis.group_mis_account"/>
                </xpath>
            </field>
        </record>
    </data>
</odoo>
