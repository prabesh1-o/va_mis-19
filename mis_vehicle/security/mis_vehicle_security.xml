<?xml version='1.0' encoding='utf-8'?>
<odoo>
    <record model="ir.module.category" id="mis_vehicle_parent">
        <field name="name">MIS Vehicle</field>
        <field name="description">MIS vehicle related modules</field>
        <field name="sequence">11</field>
    </record>

    <record model="ir.module.category" id="mis_vehicle_management">
        <field name="name">MIS Vehicles</field>
        <field name="description">Mis Vehicle Access</field>
        <field name="parent_id" ref="mis_vehicle_parent" />
    </record>

    <record id="privilege_Vehicle_Acess" model="res.groups.privilege">
        <field name="name">Vehicle Access</field>
        <field name="sequence">10</field>
        <field name="category_id" ref="mis_vehicle_management"/>
    </record>



    <record id="group_mis_vehicle_user" model="res.groups">
        <field name="name">User: Read Only</field>
        <field name="privilege_id" ref="privilege_Vehicle_Acess" />
        <field name="comment">The user will have readonly access to records.</field>
    </record>

    <!-- manager: without delete option -->
    <record id="group_mis_vehicle_manager" model="res.groups">
        <field name="name">Manager</field>
        <field name="privilege_id" ref="privilege_Vehicle_Acess" />
        <field name="implied_ids"
            eval="[(4, ref('group_mis_vehicle_user'))]" />
        <field name="comment">The user will have create,read,update access to records</field>
    </record>

    <!-- admin: all access rights -->
    <record id="group_mis_vehicle_administrator" model="res.groups">
        <field name="name">Administrator</field>
        <field name="privilege_id" ref="privilege_Vehicle_Acess" />
        <field name="implied_ids"
            eval="[(4, ref('group_mis_vehicle_manager'))]" />
        <field name="comment">The user will have all access to records</field>
    </record>
</odoo>
