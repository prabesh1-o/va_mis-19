<odoo>
  <data>
    <record model="ir.ui.view" id="mis_vehicle_list">
      <field name="name">mis.vehicle.list</field>
      <field name="model">mis.vehicle</field>
      <field name="arch" type="xml">
        <list string="Vehicles">
          <field name="vehicle_number" />
          <field name="vin" />
          <field name="color" />
        </list>
      </field>
    </record>

    <record model="ir.ui.view" id="mis_vehicle_kanban">
      <field name="name">mis.vehicle.kanban</field>
      <field name="model">mis.vehicle</field>
      <field name="arch" type="xml">
        <kanban>
          <templates>
            <t t-name="card">
              <div class="oe_kanban_global_click">
                <div class="o_kanban_image">
                  <field name="image" widget='image' class="oe_avatar" />
                </div>
                <div class="oe_kanban_details">
                  <strong class="o_kanban_record_title">
                    <t t-if="record.vehicle_number.raw_value">
                      <field name="vehicle_number" />
                    </t>
                  </strong>
                  <div>
                    <span t-if="record.customer_id.raw_value">
                      <strong><span>Customer: </span></strong>
                      <field name="customer_id" />
                    </span>
                  </div>
                  <div class="o_kanban_tags_section">
                    <field name="tag_ids" widget="many2many_tags" options="{'color_field': 'color'}" />
                  </div>
                </div>
              </div>
            </t>
          </templates>
        </kanban>
      </field>
    </record>

    <record model="ir.ui.view" id="mis_vehicle_form">
      <field name="name">mis.vehicle.form</field>
      <field name="model">mis.vehicle</field>
      <field name="arch" type="xml">
        <form string="Form">
          <sheet>
            <field name="image" widget='image' class="oe_avatar" />
            <div class="oe_title col-6">
              <label for="vehicle_number" />
              <h1>
                <field name="vehicle_number" placeholder="Vehicle Number" />
              </h1>
            </div>
            <div class="oe_title col-3">
              <label for="vin" />
              <h2>
                <field name="vin" />
              </h2>
              <label for="tag_ids" />
              <field name="tag_ids" widget="many2many_tags" options="{'color_field': 'color', 'no_create_edit': True}" />
            </div>
            <group col="2">
              <group string="Vehicle" name="vehicle">
                <field name="customer_id" />
                <field name="vehicle_type" />
                <field name="engine_hours" />
                <field name="cubic_capacity" />
                <field name="trailer" />
              </group>
              <notebook>
                <page string="Model" name="model_info">
                  <group>
                    <group string="Model Info">
                      <field name="vehicle_company_name" />
                      <field name="model_year" />
                      <field name="transmission" />
                      <field name="color" />
                      <field name="seat_capacity" />
                      <field name="payload_capacity" />
                    </group>
                    <group string="Engine">
                      <field name="engine_no" />
                      <field name="horsepower" />
                      <field name="fuel_type" />
                    </group>
                  </group>
                </page>
                <page string="Tax Info">
                  <group>
                    <group string="Fiscality">
                      <field name="cubic_capacity_taxation" />
                    </group>
                  </group>
                </page>
                <page string="Blue Book Information">
                  <group>
                    <group string="Blue Book Information">
                      <field name="blue_book_no" />
                      <field name="registered_on" />
                      <field name="registered_name" />
                      <field name="last_renewal_date" />
                      <field name="expiry_date" />
                      <field name="permitted_area" />
                    </group>
                  </group>
                </page>
                <page string="Note">
                  <field name="description" nolabel="1" placeholder="Write here any other information related to this vehicle" />
                </page>
              </notebook>
            </group>
          </sheet>
        </form>
      </field>
    </record>

    <record id="mis_vehicle_search" model="ir.ui.view">
      <field name="name">mis.vehicle.search</field>
      <field name="model">mis.vehicle</field>
      <field name="arch" type="xml">
        <search>
          <field name="vehicle_number" string="License Plate" />
          <field name="tag_ids" string="Tag" />
          <filter name="group_by_fuel_type" string="Fuel Type" context="{'group_by': 'fuel_type'}" />
        </search>
      </field>
    </record>

    <record model="ir.actions.act_window" id="mis_vehicle_action_window">
      <field name="name">Vehicle</field>
      <field name="res_model">mis.vehicle</field>
      <field name="view_mode">kanban,list,form</field>
    </record>

    <menuitem id="mis_vehicle_sub_menu" name="Vehicles" action="mis_vehicle_action_window" parent="va_mis.res_partner_menu_customers" sequence="3"/>
  </data>
</odoo>
