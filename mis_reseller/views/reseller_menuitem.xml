<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="mis_reseller_view_form" model="ir.ui.view">
        <field name="name">mis.reseller.view.form</field>
        <field name="model">mis.reseller</field>
        <field name="arch" type="xml">

            <form string="Mis Reseller">

                <header>
                    <field name="is_reseller" invisible="1"/>

                    <button name="btn_create_sale_order" type="object" confirm="Do you want to create Quotation?" class="oe_highlight" invisible="not id">
                        Create Quotation
                    </button>

                </header>


                <sheet>

                    <div class="oe_button_box" name="button_box">

                        <field name="sale_order_ids" invisible="1"/>


                        <button class="oe_stat_button" name="action_view_sale_orders" type="object" icon="fa-pencil-square-o">

                            <div class="o_field_widget o_stat_info">

                                <span class="o_stat_value">
                                </span>

                                <span class="o_stat_text">
                                    Sale Order
                                </span>

                            </div>

                        </button>


                        <button class="oe_stat_button" name="action_view_devices" type="object" icon="fa-microchip">

                            <div class="o_field_widget o_stat_info">

                                <span class="o_stat_value">

                                    <field name="device_count" widget="statinfo" nolabel="1"/>

                                </span>

                                <span class="o_stat_text">
                                    Stock Devices
                                </span>

                            </div>

                        </button>

                    </div>


                    <field name="image_1920" widget="image" class="oe_avatar" options="{'zoom': true}"/>


                    <div class="oe_title mb24">

                        <h1>
                            <field name="name" placeholder="E.g. John Doe"/>
                        </h1>

                    </div>


                    <group>

                        <field name="related_location_id"/>

                    </group>


                    <group>

                        <group string="Details">

                            <field name="phone"/>
                            <field name="mobile"/>
                            <field name="email"/>
                            <field name="website"/>
                            <field name="vat"/>

                        </group>


                        <group string="Address">

                            <field name="country_id"/>
                            <field name="state_id"/>
                            <field name="city"/>
                            <field name="street"/>
                            <field name="street2"/>
                            <field name="zip"/>

                        </group>

                    </group>


                </sheet>

            </form>

        </field>
    </record>



    <record id="mis_reseller_view_tree" model="ir.ui.view">

        <field name="name">mis.reseller.view.list</field>

        <field name="model">mis.reseller</field>

        <field name="arch" type="xml">

            <list string="Mis Reseller">

                <field name="name"/>
                <field name="phone"/>
                <field name="mobile"/>
                <field name="email"/>
                <field name="city"/>

            </list>

        </field>

    </record>




    <record id="mis_reseller_view_kanban" model="ir.ui.view">

        <field name="name">mis.reseller.view.kanban</field>

        <field name="model">mis.reseller</field>

        <field name="arch" type="xml">


            <kanban class="o_res_partner_kanban">

                <templates>

                    <t t-name="card">


                        <div class="oe_kanban_global_click o_res_partner_kanban">


                            <div class="oe_kanban_details">


                                <div class="o_kanban_image o_kanban_image_fill_left o_kanban_image_full">

                                    <field name="image_1920" widget="image" class="oe_kanban_avatar"/>

                                </div>


                                <div>

                                    <strong class="o_kanban_record_title">

                                        <field name="name"/>

                                    </strong>


                                    <div class="o_kanban_tags_section"/>


                                    <ul>

                                        <li>
                                            <field name="email"/>
                                        </li>


                                        <li>

                                            <field name="city"/>
,
                                            <field name="country_id"/>

                                        </li>


                                    </ul>


                                </div>


                            </div>


                        </div>


                    </t>


                </templates>


            </kanban>


        </field>

    </record>




    <record model="ir.actions.act_window" id="res_partner_reseller_window">

        <field name="name">Resellers</field>

        <field name="res_model">mis.reseller</field>

        <field name="view_mode">kanban,list,form</field>

        <field name="view_id" ref="mis_reseller_view_kanban"/>

        <field name="domain">
            [('is_reseller', '=', True)]
        </field>

    </record>



    <menuitem id="mis_res_partner_vendor_sub_menu" name="Reseller" action="res_partner_reseller_window" parent="va_mis.res_partner_menu_customers" sequence="6"/>


</odoo>