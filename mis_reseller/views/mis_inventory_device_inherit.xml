<?xml version='1.0' encoding='utf-8'?>
<odoo>
    <data>
        <record id="mis_inventory_device_list_inherit" model="ir.ui.view">
            <field name="name">mis.inventory.device.list.inherit</field>
            <field name="model">mis.inventory.device</field>
            <field name="inherit_id" ref="mis_inventory_mis_device.mis_inventory_device_view_list" />
            <field name="arch" type="xml">
                <data>
                    <xpath expr="//field[@name='location_id']" position="after">
                        <field name="stock_sim_id" />
                    </xpath>
                </data>
            </field>
        </record>

        <record id="mis_inventory_device_form_inherit" model="ir.ui.view">
            <field name="name">mis.inventory.device.form.inherit</field>
            <field name="model">mis.inventory.device</field>
            <field name="inherit_id" ref="mis_inventory_mis_device.mis_inventory_device_view_form" />
            <field name="arch" type="xml">
                <data>
                    <xpath expr="//header" position="inside">
                        <button name="action_register_devices" string="Device Form" type="object"
                            class="btn btn-primary" invisible="is_device_created"></button>
                    </xpath>

                    <xpath expr="//div[@name='button_box']" position="inside">
                        <button class="oe_stat_button" name="action_view_out_delivery"
                            type="object" icon="fa-truck">
                            <div class="o_field_widget o_stat_info">
                                <span class="o_stat_value">
                                    <field name="delivery_count" widget="statinfo" nolabel="1"
                                        class="mr4" />
                                </span>
                                <span class="o_stat_text">Delivery</span>
                            </div>
                        </button>
                    </xpath>

                    <xpath expr="//div[@name='button_box']" position="after">
                        <field name="is_device_created" invisible="1" />
                        <widget name="web_ribbon" title="Device Activated"
                            invisible="not is_device_created" bg_color="bg-success" />
                    </xpath>

                    <xpath expr="//field[@name='location_id']" position="after">
                        <field name="stock_sim_id" readonly="0" />
                    </xpath>
                </data>
            </field>
        </record>
    </data>

</odoo>
