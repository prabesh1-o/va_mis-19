<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record model="ir.module.category" id="mis_renewal_management_parent">
        <field name="name">MIS Device Renewal</field>
        <field name="description">MIS Device Renewal related modules</field>
        <field name="sequence">20</field>
    </record>

    <record model="ir.module.category" id="mis_device_renwal_management">
        <field name="name">MIS Device Renewal</field>
        <field name="description">MIS Device Renewal</field>
        <field name="parent_id" ref="mis_renewal_management_parent" />
    </record>

     <record id="privilege_mis_device_renwal_management" model="res.groups.privilege">
        <field name="name">MIS Device Renewal</field>
        <field name="category_id" ref="mis_device_renwal_management"/>
        <field name="sequence">10</field>
    </record>

    <!-- User: Own Documents Only -->
    <record id="group_mis_device_renewal_user_readonly" model="res.groups">
        <field name="name">User: Read Only</field>
        <field name="privilege_id" ref="privilege_mis_device_renwal_management" />
        <field name="comment">The user will have readonly access to their records.</field>
    </record>

    <record id="group_mis_device_renewal_user_own_documents" model="res.groups">
        <field name="name">User: Own Documents</field>
        <field name="implied_ids"
            eval="[(4, ref('group_mis_device_renewal_user_readonly'))]" />
        <field name="privilege_id" ref="privilege_mis_device_renwal_management" />
        <field name="comment">TThe user will have create,read,update access to their own records.</field>
    </record>

    <record id="group_mis_device_renewal_all_documents" model="res.groups">
        <field name="name">Manager</field>
        <field name="privilege_id" ref="privilege_mis_device_renwal_management" />
        <field name="implied_ids"
            eval="[(4, ref('group_mis_device_renewal_user_own_documents'))]" />
        <field name="comment">The user will have create,read,update access for all records</field>
    </record>

    <record id="group_mis_device_renewal_administrator" model="res.groups">
        <field name="name">Administrator</field>
        <field name="privilege_id" ref="privilege_mis_device_renwal_management" />
        <field name="implied_ids"
            eval="[(4, ref('group_mis_device_renewal_all_documents'))]" />
        <field name="comment">The user will have all access to all records</field>
        <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]" />
    </record>
</odoo>
