<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="email_template_pi_renewal" model="mail.template">
            <field name="name">Renewal: Send PI</field>
            <field name="model_id" ref="model_mis_device_renewal"/>
            <field name="subject">{{ object.employee_ids.company_id.name }} (Ref {{ object.name or 'n/a' }})</field>
            <field name="email_from">{{ (object.employee_ids.user_id.email_formatted or object.employee_ids.company_id.email_formatted) }}</field>
            <field name="partner_to">{{ object.customer_ids.id }}</field>
            <field name="description">Used by assignee when they send proforma to prospects</field>
            <field name="body_html" type="html">
                <div style="margin: 0px; padding: 0px;">
                    <p style="margin: 0px; padding: 0px; font-size: 13px;">
        Hello,
                        <br/>
                        <br/>
        Your Pro forma invoice for renewal
                        #                        <span style="font-weight: bold;" t-out="object.name or ''">Renewal</span>
            amounting in <span style="font-weight: bold;" t-out="format_amount(object.total_renewal_amount, object.company_currency_id)"/>
 is available.
                    <br/>
                    <br/>
        Do not hesitate to contact us if you have any questions.
                    <t t-if="not is_html_empty(object.employee_ids.user_id.signature)">
                        <br/>
                        <br/>
                        <t t-out="object.employee_ids.user_id.signature or ''">--                            <br/>
Mitchell Admin</t>
                    </t>
                    <br/>
                    <br/>
                </p>
            </div>
        </field>
        <field name="report_template_ids" eval="[(4, ref('action_report_pro_forma_invoice_renewal'))]"/>
        <!-- <field name="report_name">{{ (object.name or '').replace('/','_') }}</field> -->
        <field name="auto_delete" eval="True"/>
    </record>
</data>
</odoo>
