<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.mis.device.renewal</field>
        <field name="model">res.config.settings</field>
        <field name="priority" eval="100"/>
        <field name="inherit_id" ref="va_mis.res_config_settings_view_form" />
        <field name="arch" type="xml">
            <xpath expr="//div[@name='mis_config_holder']" position="inside">
                <div class="mis_device_renewal">
                    <h2>MIS Device Renewal</h2>
                    <div class="row mt16 o_settings_container">
                        <div class="col-12 col-lg-6 o_setting_box">
                            <div class="o_setting_right_pane">
                                <span class="o_form_label">Renewal preserve days</span>
                                <div class="text-muted">
                                    Enter the days to hide the completed renewals
                                </div>
                                <div class="content-group">
                                    <div class="mt16">
                                        <field name="mis_renewal_completion_days_count" class="o_light_label"/>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="col-12 col-lg-6 o_setting_box">
                            <div class="o_setting_right_pane">
                                <span class="o_form_label">Expiry count days</span>
                                <div class="text-muted">
                                    Enter the days to update the expired device to renewal
                                </div>
                                <div class="content-group">
                                    <div class="mt16">
                                        <field name="mis_renewal_expiry_days_count" class="o_light_label"/>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </xpath>
        </field>
    </record>
</odoo>
