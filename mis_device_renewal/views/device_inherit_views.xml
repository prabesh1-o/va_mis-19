<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="mis_device_renewal_inherits_mis_device_list" model="ir.ui.view">
            <field name="name">mis.device.renewal.inherit.mis_device.list</field>
            <field name="model">mis.device</field>
            <field name="inherit_id" ref="mis_device.mis_device_list"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='customer_id']" position="after">
                    <field name="renewal_price" optional="hide"/>
                    <field name="renewal_package_id" optional="hide"/>
                </xpath>
            </field>
        </record>
        <record id="mis_device_renewal_inherits_mis_device_form" model="ir.ui.view">
            <field name="name">mis.device.renewal.inherit.mis_device.form</field>
            <field name="model">mis.device</field>
            <field name="inherit_id" ref="mis_device.mis_device_form"/>
            <field name="arch" type="xml">
                <xpath expr="//div[@name='button_box']" position="inside">
                    <button name="return_action_to_open" type="object" class="oe_stat_button" context="{'xml_id':'mis_device_renewal.mis_device_renewal_history_action'}" icon="fa-history">
                        <field name="renewal_history_count" widget="statinfo" string="Renewal History"/>
                    </button>
                </xpath>
                <xpath expr="//field[@name='installation_price']" position="after">
                    <field name="renewal_price" />
                    <span class="ms-2" invisible="not tax_id or renewal_price == 0"/>
                    <field name="renewal_tax_string" nolabel="1" invisible="not tax_id or renewal_price == 0"/>
                    <field name="tax_id" invisible="1"/>
                </xpath>
            </field>
        </record>
    </data>
</odoo>
