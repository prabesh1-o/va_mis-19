<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="mis_device_renewal_history_list" model="ir.ui.view">
            <field name="name">mis.device.renewal.history.list</field>
            <field name="model">mis.device.renewal.history</field>
            <field name="arch" type="xml">
                <list string="Renewal History" create="0">
                    <field name="name"/>
                    <field name="company_currency_id" invisible="1"/>
                    <field name="device_id"/>
                    <field name="customer_ids" widget="many2many_tags"/>
                    <field name="renewal_date"/>
                    <field name="renewal_package_id"/>
                    <field name="renewal_price" widget="monetary"/>
                    <field name="payment_date"/>
                    <field name="old_expiry_date"/>
                    <field name="expiry_date"/>
                    <field name="grace_period_days_count"/>
                    <field name="renewal_id" optional="hide"/>
                </list>
            </field>
        </record>

        <record id="mis_device_renewal_history_search" model="ir.ui.view">
            <field name="name">mis.device.renewal.history.search</field>
            <field name="model">mis.device.renewal.history</field>
            <field name="arch" type="xml">
                <search>
                    <field name="customer_ids" string="Customer"/>
                    <field name="device_id" string="Device IMEI"/>
                    <separator/>
                    <filter name="device" string="Device" context="{'group_by': 'device_id'}"/>

                </search>
            </field>
        </record>

    <record id="mis_device_renewal_history_form" model="ir.ui.view">
        <field name="name">mis.device.renewal.history.form</field>
        <field name="model">mis.device.renewal.history</field>
        <field name="arch" type="xml">
            <form string="Renewal History" edit="0">
                <sheet>
                    <div>
                        <div class="oe_title">
                            <h2>
                                <field name="name"/>
                            </h2>
                        </div>
                        <group>
                            <group>
                                <field name="company_currency_id" invisible="1"/>
                                <field name="device_id"/>
                                <field name="customer_ids" widget="many2many_tags"/>
                                <field name="renewal_date"/>
                                <field name="renewal_id"/>
                            </group>
                            <group>
                                <field name="renewal_package_id"/>
                                <field name="renewal_price" widget="monetary"/>
                                <field name="payment_date"/>
                                <field name="expiry_date"/>
                                <field name="old_expiry_date"/>
                                <field name="grace_period_days_count"/>
                            </group>
                        </group>
                    </div>
                </sheet>
            </form>
        </field>
    </record>

    <record model="ir.actions.act_window" id="mis_device_renewal_history_action">
        <field name="name">Renewal History</field>
        <field name="res_model">mis.device.renewal.history</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="renewal_history_menu" name="Renewal History" parent="mis_renewal_menu" action="mis_device_renewal_history_action" sequence="3"/>
</data>
</odoo>
