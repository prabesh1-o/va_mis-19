<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="mis_sim_device_history_view_list" model="ir.ui.view">
        <field name="name">mis.sim.device.history.view.list</field>
        <field name="model">mis.sim.device.history</field>
        <field name="arch" type="xml">
            <list string="Device History" create="0">
                <field name="sim_id"/>
                <field name="device_id"/>
                <field name="vehicle_id"/>
                <field name="customer_id"/>
                <field name="installed_date"/>
            </list>
        </field>
    </record>

    <record id="mis_sim_device_history_view_form" model="ir.ui.view">
        <field name="name">mmis.sim.device.history.view.form</field>
        <field name="model">mis.sim.device.history</field>
        <field name="arch" type="xml">
            <form string="Device History">
                <sheet>
                    <group>
                        <field name="sim_id"/>
                        <field name="device_id"/>
                        <field name="installed_date"/>
                        <field name="vehicle_id"/>
                        <field name="customer_id"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record model="ir.actions.act_window" id="mis_sim_device_history_action">
        <field name="name">Device History</field>
        <field name="res_model">mis.sim.device.history</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
