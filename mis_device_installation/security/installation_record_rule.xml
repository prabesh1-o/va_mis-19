<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="mis_installations_view_only_assigned_record" model="ir.rule">
            <field name="name">User can only see their assigned installations</field>
            <field name="model_id" ref="model_mis_device_installation" />
            <field name="domain_force">[('employee_ids.user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('group_mis_device_installation_user_readonly'))]" />
        </record>

        <record id="mis_installations_manager" model="ir.rule">
            <field name="name">User can see all installations</field>
            <field name="model_id" ref="model_mis_device_installation" />
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('group_mis_device_installation_all_documents'))]" />
        </record>
    </data>
</odoo>
