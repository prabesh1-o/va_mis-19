<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record model="ir.ui.view" id="mis_installation_list">
            <field name="name">mis.device.installation.list</field>
            <field name="model">mis.device.installation</field>
            <field name="arch" type="xml">
                <list string="Installation" multi_edit="1">
                    <field name="customer_id" />
                    <field name="tag_ids" widget="many2many_tags" options="{'color_field': 'color'}" />
                    <field name="employee_ids" widget="many2many_avatar_user" />
                    <field name="total_installation_price" sum="Total Installation Price" />
                    <field name="company_currency_id" invisible="1" />
                </list>
            </field>
        </record>

        <record model="ir.ui.view" id="mis_device_installation_kanban_view">
            <field name="name">mis.device.installation.kanban.view</field>
            <field name="model">mis.device.installation</field>
            <field name="arch" type="xml">
                <kanban default_group_by="stage_id" class="o_kanban_small_column o_kanban_project_tasks" sample="1">
                    <field name="stage_id" options='{"group_by_tooltip": {"requirements": "Requirements"}}' />
                    <progressbar field="stage_id" colors='{}' />
                    <templates>
                        <t t-name="card">
                            <div class="oe_kanban_card oe_kanban_global_click border-2 rounded-3 mt-2">
                                <div class="oe_kanban_content ">
                                    <div class="o_kanban_record_top">
                                        <div class="o_kanban_record_headings">
                                            <strong class="o_kanban_record_title">
                                                <field name="customer_id" />
                                            </strong>
                                        </div>
                                    </div>
                                    <div class="o_kanban_record_body">
                                        <div class="">
                                            <div>
                                                <t t-if="record.tag_ids.raw_value">
                                                    <field name="tag_ids" widget="many2many_tags" options="{'color_field': 'color'}" />
                                                </t>
                                            </div>
                                            <small>
                                                <div>
                                                    <t t-if="record.date_deadline.raw_value">
                                                        <span>
                                                            <strong>Deadline: </strong>
                                                            <field name="date_deadline" />
                                                        </span>
                                                    </t>
                                                </div>
                                                <div>
                                                    <t t-if="record.total_installation_price.raw_value">
                                                        <span>
                                                            <strong>Amount: </strong>
                                                            <field name="total_installation_price" />
                                                            <field name="company_currency_id" invisible="1" />
                                                        </span>
                                                    </t>
                                                </div>
                                            </small>
                                        </div>
                                    </div>
                                    <div class="o_kanban_record_bottom " t-if="!selection_mode">
                                        <div class="oe_kanban_bottom_left">
                                            <div>
                                                <small>
                                                    <strong>
                                                        <span class="text-success">
                                                            <field name="total_installed_devices" />
                                                            <span>-</span>
                                                        </span>
                                                        <span>
                                                            <field name="total_neutral_devices" />
                                                            <span>-</span>
                                                        </span>
                                                        <span class="text-danger">
                                                            <field name="total_canceled_devices" />
                                                        </span>
                                                        <span>/</span>
                                                        <field name="total_installations" />
                                                        <span> Installations</span>
                                                    </strong>
                                                </small>
                                            </div>
                                        </div>
                                        <div class="oe_kanban_bottom_right" t-if="!selection_mode">
                                            <t t-if="record.employee_ids.raw_value">
                                                <span class="p-1">
                                                    <field name="employee_ids" widget="many2many_avatar_user" />
                                                </span>
                                            </t>
                                            <field name="activity_ids" widget="kanban_activity" />
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </t>
                    </templates>
                </kanban>
            </field>
        </record>

        <record id="mis_installation_form" model='ir.ui.view'>
            <field name="name">mis.device.installation.form</field>
            <field name="model">mis.device.installation</field>
            <field name="arch" type="xml">
                <form string="installation">
                    <header>
                        <button name="btn_configure_customer_and_devices" type="object">Configure</button>
                        <field name="stage_id" widget="statusbar" class="o_field_statusbar" />
                    </header>
                    <sheet>
                        <div class="oe_button_box" name="button_box"></div>
                        <group name="installation">
                            <group string="Details">
                                <field name="customer_id" />
                                <field name="is_relocation" widget="boolean_toggle" />
                                <field name="tag_ids" widget="many2many_tags" options="{'color_field': 'color'}" />
                                <field name="date_deadline" />
                                <field name="employee_ids" widget="many2many_avatar_user" />
                            </group>
                            <group string="Device Information">
                                <field name="total_installations" />
                                <field name="completeness" widget="progressbar" />
                            </group>
                            <group string="Contact Information">
                                <field name="contact_person_name" />
                                <field name="contact_person_phone" />
                                <field name="installation_address" />
                                <button string="Autofill" name="action_auto_fill_contact_details" type="object" class="oe_highlight" confirm="Are you sure you want to proceed? This will fill in the contact information on all of the lines." />
                            </group>
                        </group>
                        <notebook>
                            <page name="installation_line" string="Installation">
                                <field name="installation_line_ids">
                                    <list decoration-success="state == 'installed'" decoration-danger="state == 'canceled'">
                                        <field name="is_installation_complete" invisible="1" />
                                        <field name="company_currency_id" invisible="1" />
                                        <field name="state" invisible="1" />
                                        <field name="installation_date" optional="hide" />
                                        <field name="installation_address" optional="hide" />
                                        <field name="contact_person_name" optional="hide" />
                                        <field name="contact_person_phone" optional="hide" />
                                        <field name="installation_address" optional="hide" />
                                        <field name="renewal_price" widget="monetary" sum="Total Renewal Price" />
                                        <field name="installation_price" widget="monetary" sum="Total Installation Price" />
                                        <field name="employee_ids" widget="many2many_avatar_user" />
                                        <button icon="fa-check" type="object" name="btn_update_installation_state" string=" " invisible="state == 'installed'" context="{'is_installation_btn': 1 }" confirm="Do you want to confirm installation?" />
                                        <button icon="fa-undo" type="object" name="btn_update_installation_state" string=" " attrs="{'invisible':[('state','!=','installed')]}" confirm="Do you want to revert installation?" />
                                    </list>
                                    <form>
                                        <group>
                                            <group string="Installation Information" name="installation_information">
                                                <field name="is_installation_complete" invisible="1" />
                                                <field name="installation_date" />
                                                <field name="expiry_date" />
                                                <field name="company_currency_id" invisible="1" />
                                                <field name="installation_price" widget="monetary" sum="Total Installation Price" />
                                                <field name="renewal_price" widget="monetary" sum="Total Renewal Price" />
                                                <field name="state" />
                                                <field name="canceled_reason" attrs="{'invisible': [('state','!=','canceled')], 'required': [('state','=','canceled')]}" />
                                                <field name="employee_ids" widget="many2many_avatar_user" />
                                            </group>
                                        </group>
                                        <group>
                                            <group string="Contact Information">
                                                <field name="contact_person_name" />
                                                <field name="contact_person_phone" />
                                                <field name="installation_address" />
                                            </group>
                                        </group>
                                    </form>
                                </field>
                            </page>
                        </notebook>
                    </sheet>
                    <!-- Chatter -->
                    <chatter>
                        <field name="message_follower_ids" groups="base.group_user" />
                        <field name="activity_ids" />
                        <field name="message_ids" />
                    </chatter>
                </form>
            </field>
        </record>

        <record id="mis_device_installation_graph" model="ir.ui.view">
            <field name="name">mis.device.installation.graph</field>
            <field name="model">mis.device.installation</field>
            <field name="arch" type="xml">
                <graph string="Installation" sample="1">
                    <field name="customer_id"/>
                </graph>
            </field>
        </record>

        <record id="mis_device_installation_search" model="ir.ui.view">
            <field name="name">mis.device.installation.search</field>
            <field name="model">mis.device.installation</field>
            <field name="arch" type="xml">
                <search>
                    <field name="customer_id" string="Customer" />
                    <filter name="create_date" string="Created Today" domain="[('create_date','&gt;', (context_today() - datetime.timedelta(days=1)).strftime('%Y-%m-%d'))]" />
                    <separator />
                    <filter invisible="1" string="Late Activities" name="activities_overdue" domain="[('my_activity_date_deadline', '&lt;', context_today().strftime('%Y-%m-%d'))]" />
                    <filter invisible="1" string="Today Activities" name="activities_today" domain="[('my_activity_date_deadline', '=', context_today().strftime('%Y-%m-%d'))]" />
                    <filter invisible="1" string="Future Activities" name="activities_upcoming_all" domain="[('my_activity_date_deadline', '&gt;', context_today().strftime('%Y-%m-%d'))]" />
                    <separator />
                </search>
            </field>
        </record>

        <record model="ir.actions.act_window" id="mis_installation_action">
            <field name="name">Installation</field>
            <field name="res_model">mis.device.installation</field>
            <field name="view_mode">kanban,list,graph,form</field>
        </record>

        <menuitem id="mis_installation_menu" name="Installation" parent="va_mis.mis_root_menu" sequence="11">
            <menuitem id="mis_installation_active_menu" name="Installations" action="mis_installation_action" sequence="1" />
        </menuitem>
    </data>
</odoo>
