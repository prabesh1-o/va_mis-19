<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="mis_installation_form_inherit_device" model="ir.ui.view">
        <field name="name">mis.installation.form.inherit.device</field>
        <field name="model">mis.device.installation</field>
        <field name="inherit_id" ref="mis_device_installation.mis_installation_form" />
        <field name="arch" type="xml">
            <data>
                <xpath expr="//field[@name='installation_line_ids']/list/field[@name='state']" position="after">
                    <field name="vehicle_id"/>
                </xpath>
                <xpath expr="//field[@name='installation_line_ids']/form/group/group[@name='device_information']" position="inside">
                    <field name="vehicle_id"/>
                </xpath>
            </data>
        </field>
    </record>
</odoo>
