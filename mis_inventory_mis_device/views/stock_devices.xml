<odoo>
    <data>
        <record id="mis_inventory_device_view_form" model="ir.ui.view">
            <field name="name">mis_iventory_device.view.form</field>
            <field name="model">mis.inventory.device</field>
            <field name="arch" type="xml">
                <form string="MIS Inventory Device">
                    <header>
                    </header>
                    <sheet>
                        <div class="oe_button_box" name="button_box"></div>
                        <group name="details">
                            <field name="active" invisible="1" />
                            <field name="imei_no" />
                            <field name="product_id" />
                            <field name="device_model_id" />
                            <field name="location_id" />
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="mis_inventory_device_view_list" model="ir.ui.view">
            <field name="name">mis_inventory_device.view.list</field>
            <field name="model">mis.inventory.device</field>
            <field name="arch" type="xml">
                <list string="">
                    <field name="imei_no" />
                    <field name="product_id"></field>
                    <field name="device_model_id"></field>
                    <field name="location_id"></field>
                </list>
            </field>
        </record>

        <record id="mis_inventory_device_view_search" model="ir.ui.view">
            <field name="name">mis_inventory_device.view.search</field>
            <field name="model">mis.inventory.device</field>
            <field name="arch" type="xml">
                <search string="imei">
                    <field name="imei_no" />
                    <field name="product_id"></field>
                    <field name="device_model_id"></field>
                    <field name="location_id"></field>
                    <filter name="group_by_location" string="Location"
                        context="{'group_by':'location_id'}" />
                    <filter name="group_by_product" string="Product"
                        context="{'group_by':'product_id'}" />
                </search>
            </field>
        </record>

        <record id="action_mis_inventory_device" model="ir.actions.act_window">
            <field name="name">MIS Inventory Device</field>
            <field name="res_model">mis.inventory.device</field>
            <field name="view_mode">list,form</field>
            <field name="domain">[]</field>
            <field name="context">{'search_default_group_by_location': 1}</field>
        </record>

        <menuitem id="menu_mis_inventory_stock_item" name="Stock Devices" sequence="3"
            action="action_mis_inventory_device"
            parent="mis_inventory.mis_menu_inventory_operations" />
    </data>
</odoo>
