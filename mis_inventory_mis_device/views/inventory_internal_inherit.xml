<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_form_picking_imternal_inherit" model="ir.ui.view">
        <field name="name">stock.picking.form.internal.inherit</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='extra']" position="after">
                <page
                    name="devices"
                    string="Devices"
                    invisible="picking_type_code != 'internal'">

                    <field
                        name="device_imei_ids"
                        nolabel="1"
                        options="{'no_create_edit': True}"
                        readonly="state == 'done'"
                        domain="[('location_id', '=', location_id), ('active', '=', True)]"
                        context="{'active_test': False}"/>

                </page>
            </xpath>
        </field>
    </record>
</odoo>