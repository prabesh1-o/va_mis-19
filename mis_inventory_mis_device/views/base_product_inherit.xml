<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="product_product_form_view_inherit_imei" model="ir.ui.view">
        <field name="name">product.product.form.inherit.imei</field>
        <field name="model">product.product</field>
        <field name="inherit_id" ref="product.product_normal_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button class="action_view_imei_devices"
                        name="action_view_imei_devices"
                        type="object"
                        icon="fa-signal"
                        invisible="not purchase_ok">
                    <div class="o_field_widget o_stat_info">
                        <span class="o_stat_value">
                            <field name="imei_count" nolabel="1" class="me-1"/>
                        </span>
                        <span class="o_stat_text">Device IMEI</span>
                    </div>
                </button>
            </xpath>
        </field>
    </record>
</odoo>