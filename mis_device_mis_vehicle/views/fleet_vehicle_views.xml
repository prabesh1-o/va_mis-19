<?xml version='1.0' encoding='utf-8'?>
<odoo>
    <record id="mis_vehicle_form_inherited" model="ir.ui.view">
        <field name="name">mis.vehicle.form.inherited</field>
        <field name="model">mis.vehicle</field>
        <field name="inherit_id" ref="mis_vehicle.mis_vehicle_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='model_info']" position="after">
                <page name="device_info" string="Devices">
                    <field name="device_ids" />
                </page>
            </xpath>
        </field>
    </record>
</odoo>
