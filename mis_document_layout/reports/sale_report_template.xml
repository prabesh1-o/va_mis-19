<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="mis_sale_order_report" inherit_id="sale.report_saleorder_document">
        <xpath expr="//div[@class='page']" position="before">
            <t t-set="information_block">
                <t t-set="addressclass" t-value="('col-5' if doc.partner_shipping_id != doc.partner_invoice_id else 'col')"/>
                <strong>
                    <t t-if="doc.partner_shipping_id == doc.partner_invoice_id">
                        Invoicing and Shipping Address:
                    </t>
                </strong>
                <div class="d-flex gap-1 justify-content-between overflow-hidden">
                    <div t-att-class="addressclass">
                        <t t-if="doc.partner_shipping_id != doc.partner_invoice_id">
                            <strong>Invoicing Address:</strong>
                        </t>
                        <div t-field="doc.partner_invoice_id" t-options='{"widget": "contact", "fields": ["address", "name", "phone", "mobile"], "no_marker": True, "phone_icons": True}'/>
                    </div>
                    <div class="col-6 offset-1">
                        <t t-if="doc.partner_shipping_id != doc.partner_invoice_id">
                            <strong>Shipping Address:</strong>
                            <div t-field="doc.partner_shipping_id" t-options='{"widget": "contact", "fields": ["address", "name", "phone", "mobile"], "no_marker": True, "phone_icons": True}'/>
                        </t>
                    </div>
                </div>
            </t>
        </xpath>
        <xpath expr="//div[@class='page']" position="replace">
            <div class="oe_structure"/>
            <div class="row mt-4 mb-4 d-flex" id="informations">
                <t t-set="colclass" t-value="('d-flex justify-content-end gap-1')"/>
                <div class="col-6">
                    <div class="">
                        <t t-if="doc.poc_name" class="">
                            <strong>Point of Contact:</strong>
                            <div class="">
                                <div t-field="doc.poc_name"/>
                                <div>
                                    <i class="fa fa-mobile" style="margin-right: 5px; margin-left: 5px;"></i>
                                    <span t-esc="doc.poc_phone"/>
                                </div>
                                <br />
                            </div>
                        </t>
                    </div>
                    <div class="d-flex gap-1">
                        <t t-if="doc.client_order_ref" name="informations_reference">
                            <strong>Your Reference:</strong>
                            <t t-esc="doc.client_order_ref"/>
                        </t>
                    </div>
                    <div class="">
                        <t t-if="doc.user_id.name" class="">
                            <strong>Salesperson:</strong>
                            <div class="">
                                <div t-field="doc.user_id.partner_id" t-options='{ "widget": "contact", "fields": ["name", "mobile"],"phone_icons": True}'/>
                            </div>
                        </t>
                    </div>
                </div>
                <div class="col-6 text-right">
                    <div t-att-class="colclass">
                        <strong>
                            Issue Date:
                        </strong>
                        <t t-esc="datetime.date.today()" t-options='{"widget": "date"}'/>
                    </div>
                    <div t-att-class="colclass">
                        <t t-if="doc.date_order" name="informations_date">
                            <strong t-if="doc.state in ['draft', 'sent']">Quotation Date:</strong>
                            <strong t-else="">Order Date:</strong>
                            <t t-esc="doc.date_order" t-options='{"widget": "date"}'/>
                        </t>
                    </div>
                    <div t-att-class="colclass" t-if="doc.validity_date and doc.state in ['draft', 'sent']" name="expiration_date">
                        <strong>Expiration:</strong>
                        <t t-esc="doc.validity_date" t-options='{"widget": "date"}'/>
                    </div>
                    <div t-att-class="colclass" t-if="doc.payment_term_id.note">
                        <strong style="margin-right: 5px;">Payment Terms:</strong>
                        <t t-esc="doc.payment_term_id.note.replace('Payment terms:', ' ').strip()"/>
                    </div>
                </div>
            </div>

            <h2 class="h4 mt-4">
                <span t-if="env.context.get('proforma', False) or is_pro_forma">Pro-Forma Invoice # </span>
                <span t-elif="doc.state in ['draft','sent']">Quotation # </span>
                <span t-else="">Order # </span>
                <span t-field="doc.name" />
            </h2>

            <!-- Is there a discount on at least one line? -->
            <t t-set="lines_to_report" t-value="doc._get_order_lines_to_report()"/>
            <t t-set="display_discount" t-value="any(l.discount for l in lines_to_report)"/>
            <t t-set="display_renewal" t-value="any(l.renewal_price for l in lines_to_report)"/>
            <t t-set="display_price" t-value="sum(l.price_unit * l.product_uom_qty for l in lines_to_report)"/>

            <table class="table table-sm o_main_table table-borderless mt-4">
                <!-- In case we want to repeat the header, remove "display: table-row-group" -->
                <thead style="display: table-row-group">
                    <tr>
                        <th name="th_description" class="text-start">Description</th>
                        <th name="th_quantity" class="text-end">Quantity</th>
                        <th name="th_priceunit" class="text-end">Unit Price</th>
                        <th name="th_renewalprice" t-if="display_renewal" class="text-end">Renewal
                            Price</th>
                        <th name="th_discount" t-if="display_discount" class="text-end">
                            <span>Disc.%</span>
                        </th>
                        <th name="th_subtotal" class="text-end">
                            <span>Amount</span>
                        </th>
                        <th name="th_taxes" class="text-end">Taxes</th>
                        <th name="th_subtotal_tax" class="text-end">
                            <span>Total Price</span>
                        </th>
                    </tr>
                </thead>
                <tbody class="sale_tbody">

                    <t t-set="current_subtotal" t-value="0"/>

                    <t t-foreach="lines_to_report" t-as="line">

                        <t t-set="current_subtotal" t-value="current_subtotal + line.price_subtotal" groups="account.group_show_line_subtotals_tax_excluded"/>
                        <t t-set="current_subtotal" t-value="current_subtotal + line.price_total" groups="account.group_show_line_subtotals_tax_included"/>

                        <tr t-att-class="'bg-200 fw-bold o_line_section' if line.display_type == 'line_section' else 'fst-italic o_line_note' if line.display_type == 'line_note' else ''">
                            <t t-if="not line.display_type">
                                <td name="td_name">
                                    <strong>
                                        <span t-field="line.name"/>
                                    </strong>
                                    <div t-if="not (env.context.get('proforma', False) or is_pro_forma)">
                                        <ul>
                                            <t t-foreach="line.product_template_id.service_id.product_ids" t-as="product">
                                                <li>
                                                    <small>
                                                        <span t-field="product.name"/>
                                                    </small>
                                                </li>
                                            </t>
                                        </ul>
                                    </div>
                                </td>
                                <td name="td_quantity" class="text-end">
                                    <span t-field="line.product_uom_qty"/>
                                    <span t-field="line.product_uom"/>
                                </td>
                                <td name="td_priceunit" class="text-end">
                                    <span t-field="line.price_unit" t-options='{"widget": "monetary", "display_currency": doc.pricelist_id.currency_id}'/>
                                </td>
                                <td name="td_renewalprice" t-if="display_renewal" class="text-end">
                                    <span t-field="line.renewal_price"/>
                                </td>
                                <td t-if="display_discount" class="text-end">
                                    <span t-field="line.discount"/>
                                </td>
                                <td t-if="not line.is_downpayment" name="td_subtotal" class="text-end o_price_total">
                                    <span t-field="line.price_subtotal"/>
                                </td>
                                <td name="td_taxes" class="text-end">
                                    <span t-out="', '.join(map(lambda x: (x.description or x.name), line.tax_id))"/>
                                </td>
                                <td t-if="not line.is_downpayment" name="td_subtotal_tax" class="text-end o_price_total">
                                    <span t-field="line.price_total"/>
                                </td>
                            </t>
                            <t t-elif="line.display_type == 'line_section'">
                                <td name="td_section_line" colspan="99">
                                    <span t-field="line.name"/>
                                </td>
                                <t t-set="current_section" t-value="line"/>
                                <t t-set="current_subtotal" t-value="0"/>
                            </t>
                            <t t-elif="line.display_type == 'line_note'">
                                <td name="td_note_line" colspan="99">
                                    <span t-field="line.name"/>
                                </td>
                            </t>
                        </tr>

                        <t t-if="current_section and (line_last or doc.order_line[line_index+1].display_type == 'line_section') and not line.is_downpayment">
                            <tr class="is-subtotal text-end">
                                <td name="td_section_subtotal" colspan="99">
                                    <strong class="mr16">Section Subtotal</strong>
                                    <span t-out="current_subtotal" t-options='{"widget": "monetary", "display_currency": doc.pricelist_id.currency_id}'
                                    />
</td>
</tr>
</t>
</t>
</tbody>
</table>

<div class="clearfix" name="so_total_summary">
                                        <div id="total" class="row" name="total">
                                            <div t-attf-class="#{'col-6' if report_type != 'html' else 'col-sm-7 col-md-6'} ms-auto">
                                                <table class="table table-sm table-borderless">
                                                    <!-- Tax totals -->
                                                    <t t-if="display_discount">
                                                        <tr>
                                                            <td>
                                                                <strong>Gross Amount</strong>
                                                            </td>
                                                            <td class="text-end" style="vertical-align: baseline;">
                                                                <t t-esc="display_price" t-options='{"widget": "monetary", "display_currency": doc.pricelist_id.currency_id}'/>
                                                            </td>
                                                        </tr>
                                                        <tr>
                                                            <td>Discount Amount</td>
                                                            <td class="text-end" style="vertical-align: baseline;">
                                                                <t t-esc="doc.discount_amount" t-options='{"widget": "monetary", "display_currency": doc.pricelist_id.currency_id}'/>
                                                            </td>
                                                        </tr>
                                                    </t>
                                                    <t t-set="tax_totals" t-value="doc.tax_totals"/>
                                                    <t t-call="account.document_tax_totals"/>
                                                </table>
                                            </div>
                                        </div>
                                    </div>

                                    <div t-if="doc.signature" class="mt-4 ml64 mr4" name="signature">
                                        <div class="offset-8">
                                            <strong>Signature</strong>
                                        </div>
                                        <div class="offset-8">
                                            <img t-att-src="image_data_uri(doc.signature)" style="max-height: 4cm; max-width: 8cm;"/>
                                        </div>
                                        <div class="offset-8 text-center">
                                            <p t-field="doc.signed_by"/>
                                        </div>
                                    </div>

                                    <div>
                                        <p t-field="doc.note" name="order_note"/>
                                        <p t-if="doc.fiscal_position_id and not is_html_empty(doc.fiscal_position_id.sudo().note)" id="fiscal_position_remark">
                                            <strong>Fiscal Position Remark:</strong>
                                            <span t-field="doc.fiscal_position_id.sudo().note"/>
                                        </p>
                                    </div>
                                </xpath>
                            </template>
                        </odoo>
