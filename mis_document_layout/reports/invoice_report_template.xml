<?xml version='1.0' encoding='utf-8'?>
<odoo>
    <template id="mis_invoice_layout_report" inherit_id="account.report_invoice_document">
        <xpath expr="//div[@class='row']" position="replace">
            <div class="d-flex gap-1 justify-content-between overflow-hidden">
                <div class="col-4 mb-2">
                    <div name="name" class="mb-3">
                        <strong>Name:</strong>
                        <div t-field="o.partner_id.name" />
                    </div>
                    <div name="contact" class="mb-3">
                        <t t-if="o.partner_id.phone or o.partner_id.mobile">
                            <strong>Contact:</strong>
                            <div t-field="o.partner_id"
                                t-options='{"widget": "contact", "fields": ["phone","mobile"]}' />
                        </t>
                    </div>
                </div>

                <t t-if="o.partner_shipping_id and (o.partner_shipping_id != o.partner_id)">
                    <div class="col-4 mb-2">
                        <strong>Customer Address:</strong>
                        <div t-field="o.partner_id"
                            t-options='{"widget": "contact", "fields": ["name", "address"], "no_marker": True}' />
                    </div>
                    <div class="col-4 mb-2 tex-end">
                        <strong>Delivery Address:</strong>
                        <div t-field="o.partner_shipping_id"
                            t-options='{"widget": "contact", "fields": ["address", "name"], "no_marker": True}' />
                    </div>
                </t>

                <t t-else="">
                    <div class="col-8 d-flex justify-content-end mb-2">
                        <div>
                            <strong>Shipping and Invoice Address:</strong>
                            <div t-field="o.partner_id"
                                t-options='{"widget": "contact", "fields": ["address", "name"], "no_marker": True}' />
                        </div>
                    </div>
                </t>
            </div>
        </xpath>

        <xpath expr="//div[contains(@class,'invoice_main')]/div[contains(@class,'page')]" position="replace">
            <div class="row">
                <div class="col-6 text-start">
                    <div t-if="o.invoice_date" name="invoice_date">
                        <t t-if="o.move_type == 'out_invoice'">
                            <strong>Invoice Date:</strong>
                        </t>
                        <t t-elif="o.move_type == 'out_refund'">
                            <strong>Credit Note Date:</strong>
                        </t>
                        <t t-elif="o.move_type == 'out_receipt'">
                            <strong>Receipt Date:</strong>
                        </t>
                        <t t-else="">
                            <strong>Date:</strong>
                        </t>
                        <p class="m-0" t-field="o.invoice_date" />
                    </div>
                </div>

                <div class="col-6 text-end">
                    <div name="due_date" class="mt-2">
                        <strong>Due Date:</strong>
                        <div t-field="o.invoice_date_due" />
                    </div>
                </div>
            </div>

            <div id="informations" class="row mt-4 mb-4">
                <div class="col-12" t-if="o.name" name="origin">
                    <h2 class="h4 mt-4">
                        <strong>Invoice #</strong>
                        <span t-field="o.name" />
                    </h2>
                </div>
            </div>

            <table class="table table-sm o_main_table table-borderless mt-4 mb-6">
                <thead style="display: table-row-group" class="fs-5">
                    <tr>
                        <th name="th_description" class="text-start">
                            <span>Description</span>
                        </th>
                        <th name="th_quantity" class="text-end">
                            <span>Quantity</span>
                        </th>
                        <th name="th_priceunit"
                            t-attf-class="text-end {{ 'd-none d-md-table-cell' if report_type == 'html' else '' }}">
                            <span>Unit Price</span>
                        </th>
                        <th name="th_price_unit" t-if="display_discount"
                            t-attf-class="text-end {{ 'd-none d-md-table-cell' if report_type == 'html' else '' }}">
                            <span>Disc.%</span>
                        </th>
                        <th name="th_taxes"
                            t-attf-class="text-start {{ 'd-none d-md-table-cell' if report_type == 'html' else '' }}">
                            <span>Taxes</span>
                        </th>
                        <th name="th_subtotal" class="text-end">
                            <span>Total Price</span>
                        </th>
                    </tr>
                </thead>
                <tbody class="invoice_tbody">
                    <!-- Set current subtotal to zero -->
                    <t t-set="current_subtotal" t-value="0" />
                    <t t-set="lines" t-value="o.invoice_line_ids" />
                    <t t-if="lines">
                        <t t-foreach="lines" t-as="line">
                            <t t-set="current_subtotal"
                                t-value="current_subtotal + line.price_subtotal" />
                            <tr
                                t-att-class="'bg-200 fw-bold o_line_section fst-italic' if line.display_type == 'line_section' else 'fst-italic o_line_note' if line.display_type == 'line_note' else ''">
                                <t>
                                    <td name="td_name">
                                        <span t-field="line.name" />
                                    </td>
                                    <td name="td_quantity" class="text-end">
                                        <span t-field="line.quantity" />
                                    </td>
                                    <td name="td_priceunit" class="text-end">
                                        <span t-field="line.price_unit"
                                            t-options='{"widget": "monetary", "display_currency": o.currency_id}' />
                                    </td>
                                    <td t-if="display_discount" class="text-end">
                                        <span t-field="line.discount" />
                                    </td>
                                    <td name="td_taxes" class="text-start">
                                        <span
                                            t-out="', '.join(map(lambda x: (x.description or x.name), line.tax_ids))" />
                                    </td>
                                    <td name="td_subtotal" class="text-end">
                                        <span t-field="line.price_subtotal"
                                            t-options='{"widget": "monetary", "display_currency": o.currency_id}' />
                                    </td>
                                </t>
                            </tr>
                            <t
                                t-if="current_section and (line_last or lines[line_index+1].display_type == 'line_section')">
                                <tr class="is-subtotal text-end">
                                    <td colspan="99">
                                        <strong class="mr16">Subtotal</strong>
                                        <span
                                            t-esc="current_subtotal"
                                            t-options='{"widget": "monetary", "display_currency": o.currency_id}'
                                        />
                                    </td>
                                </tr>
                            </t>
                        </t>
                    </t>
                </tbody>
            </table>

            <div class="clearfix mb-4 mt-4">
                <div id="total" class="row">
                    <div
                        t-attf-class="#{'col-6' if report_type != 'html' else 'col-sm-7 col-md-6'} ms-auto">
                        <table class="table table-sm table-borderless"
                            style="page-break-inside: avoid;">

                            <!--Tax
                            totals-->
                            <t t-set="tax_totals" t-value="o.tax_totals" />
                            <t t-call="account.document_tax_totals" />

                            <!--Payments-->
                            <t t-if="print_with_payments">
                                <t t-if="o.payment_state != 'invoicing_legacy'">
                                    <t t-set="payments_vals"
                                        t-value="o.sudo().invoice_payments_widget and o.sudo().invoice_payments_widget['content'] or []" />
                                    <t t-foreach="payments_vals" t-as="payment_vals">
                                        <tr t-if="payment_vals['is_exchange'] == 0">
                                            <td>
                                                <i
                                                    class="oe_form_field text-end oe_payment_label">Paid
                                                    on <t t-esc="payment_vals['date']"
                                                        t-options='{"widget": "date"}' /></i>
                                            </td>
                                            <td class="text-end">
                                                <span t-esc="payment_vals['amount']"
                                                    t-options='{"widget": "monetary", "display_currency": o.currency_id}' />
                                            </td>
                                        </tr>
                                    </t>
                                    <t t-if="len(payments_vals) > 0">
                                        <tr class="border-black fw-bold">
                                            <td>Amount Due</td>
                                            <td class="text-end">
                                                <span t-field="o.amount_residual" />
                                            </td>
                                        </tr>
                                    </t>
                                </t>
                            </t>
                        </table>
                    </div>
                </div>
            </div>

            <div class="mb-3" t-if="o.move_type in ('out_invoice', 'in_refund') and o.payment_reference">
                <p name="payment_communication">
                    Payment Communication: <span class="fw-bold" t-field="o.payment_reference"/>
                    <t t-if="o.partner_bank_id">
                        <br/> on this account: <span t-field="o.partner_bank_id" class="fw-bold"/>
                    </t>
                </p>
            </div>
            <t t-set="show_qr" t-value="o.display_qr_code and o.amount_residual"/>
            <div t-if="not show_qr" name="qr_code_placeholder" class="oe_structure"/>
            <div id="qrcode" class="d-flex mb-3 avoid-page-break-inside" t-else="">
                <div class="qrcode me-3" id="qrcode_image">
                    <t t-set="qr_code_url" t-value="o._generate_qr_code(silent_errors=True)"/>
                    <p t-if="qr_code_url" class="position-relative mb-0">
                        <img t-att-src="qr_code_url"/>
                        <img src="/account/static/src/img/Odoo_logo_O.svg" id="qrcode_odoo_logo" class="top-50 start-50 position-absolute bg-white border border-3 rounded-circle"/>
                    </p>
                </div>
                <div class="d-inline text-muted lh-sm fst-italic" id="qrcode_info" t-if="qr_code_url">
                    <p>Scan this QR Code with<br/>your banking application</p>
                </div>
            </div>
        </xpath>
    </template>
</odoo>