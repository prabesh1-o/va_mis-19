<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="mis_device_manager" model="ir.rule">
            <field name="name">User can see all devices</field>
            <field name="model_id" ref="model_mis_device"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('group_mis_device_manager'))]" />
        </record>

        <record id="mis_sim_manager" model="ir.rule">
            <field name="name">User can see all sim</field>
            <field name="model_id" ref="model_mis_device"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('group_mis_sim_manager'))]" />
        </record>
    </data>

</odoo>
