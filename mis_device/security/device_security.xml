<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record model="ir.module.category" id="mis_device_management_parent">
        <field name="name">MIS Device and SIM</field>
        <field name="description">Mis Device and Sim Acess</field>
        <field name="sequence">11</field>
    </record>

    <record model="ir.module.category" id="mis_device_management">
        <field name="name">MIS Device</field>
        <field name="description">Mis Device Acess</field>
        <field name="parent_id" ref="mis_device_management_parent"/>
        <field name="sequence">21</field>
    </record>

    <!--PRIVILEGE-->
    <record id="privilege_mis_device" model="res.groups.privilege">
        <field name="name">MIS Device Access</field>
        <field name="category_id" ref="mis_device_management"/>
        <field name="sequence">10</field>
    </record>

    <!-- User: Own Documents Only -->
    <record id="group_mis_device_user" model="res.groups">
        <field name="name">User: Read Only</field>
        <field name="privilege_id" ref="privilege_mis_device"/>
        <field name="comment">The user will have read only access</field>
    </record>

    <!-- manager: without delete option -->
    <record id="group_mis_device_manager" model="res.groups">
        <field name="name">Manager</field>
        <field name="implied_ids" eval="[(4, ref('group_mis_device_user'))]" />
        <field name="privilege_id" ref="privilege_mis_device"/>
        <field name="comment">The user will have create,read,update access to all records</field>
    </record>

    <!-- admin: all access rights -->
    <record id="group_mis_device_admin" model="res.groups">
        <field name="name">Administrator</field>
        <field name="implied_ids" eval="[(4, ref('group_mis_device_manager'))]" />
         <field name="privilege_id" ref="privilege_mis_device"/>
        <field name="comment">The user will have all access to all records</field>
    </record>
</odoo>
