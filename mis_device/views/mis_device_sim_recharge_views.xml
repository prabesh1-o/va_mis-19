<?xml version='1.0' encoding='utf-8'?>
<odoo>
    <data>

        <record id="mis_device_sim_recharge_view_list" model="ir.ui.view">
            <field name="name">mis.device.sim.recharge.view.list</field>
            <field name="model">mis.device.sim.recharge</field>
            <field name="arch" type="xml">
                <list string="MIS Sim Recharge list">
                    <field name="name"/>
                    <field name="recharge_duration"/>
                    <field name="recharge_duration_type"/>
                    <field name="recharge_price"/>
                </list>
            </field>
        </record>

        <record id="mis_device_sim_recharge_view_form" model="ir.ui.view">
            <field name="name">mis.device.sim.recharge.view.form</field>
            <field name="model">mis.device.sim.recharge</field>
            <field name="arch" type="xml">
                <form string="MIS Sim Recharge Form">
                    <sheet>
                        <group>
                            <field name="name"/>
                            <field name="recharge_duration"/>
                            <field name="recharge_duration_type"/>
                            <field name="recharge_price"/>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="mis_device_sim_recharge_action" model="ir.actions.act_window">
            <field name="name">MIS Sim Recharge</field>
            <field name="res_model">mis.device.sim.recharge</field>
            <field name="view_mode">list,form</field>
        </record>

        <menuitem id="mis_device_sim_recharge_menu" name="SIM Recharge" action="mis_device.mis_device_sim_recharge_action" parent="device_sims_root_menu"/>
    </data>

</odoo>