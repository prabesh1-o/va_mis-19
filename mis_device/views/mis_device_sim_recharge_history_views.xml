<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="mis_device_sim_recharge_history_form_view" model="ir.ui.view">
            <field name="name">mis.device.sim.recharge.history.form</field>
            <field name="model">mis.device.sim.recharge.history</field>
            <field name="arch" type="xml">
                <form string="MIS Sim Recharge History Form">
                    <sheet>
                        <div class="oe_title">
                            <label for="name"/>
                            <h1>
                                <field name="name" placeholder="Title"/>
                            </h1>
                        </div>
                        <group>
                            <group>
                                <field name="sim_id"/>
                                <field name="recharge_date"/>
                                <field name="recharge_id"/>
                                <field name="recharge_price"/>
                                <field name="recharge_expiry" />
                            </group>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="mis_device_sim_recharge_history_tree_view" model="ir.ui.view">
            <field name="name">mis.device.sim.recharge.history.list</field>
            <field name="model">mis.device.sim.recharge.history</field>
            <field name="arch" type="xml">
                <list string="MIS Sim Recharge History Tree">
                    <field name="name" placeholder="Title"/>
                    <field name="sim_id"/>
                    <field name="recharge_id"/>
                    <field name="recharge_price"/>
                    <field name="recharge_date"/>
                    <field name="recharge_expiry" />
                </list>
            </field>
        </record>

        <record id="mis_device_sim_recharge_history_action" model="ir.actions.act_window">
            <field name="name">MIS Sim Recharge History</field>
            <field name="res_model">mis.device.sim.recharge.history</field>
            <field name="view_mode">list,form</field>
            <field name="help" type="html">
                <p class="oe_view_nocontent_create">
                    This model shows the recharge history of a SIM.
                </p>
            </field>
        </record>

        <menuitem name="SIM Recharge History" id="mis_device_sim_recharge_history_menuitem" parent="device_sims_root_menu" action="mis_device_sim_recharge_history_action"/>

    </data>
</odoo>