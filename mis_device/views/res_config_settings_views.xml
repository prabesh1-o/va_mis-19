<?xml version='1.0' encoding='utf-8'?>
<odoo>
    <record id="res_config_settings_view_form_inherit_mis_device_sim_recharge" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit</field>
        <field name="model">res.config.settings</field>
        <field name="priority" eval="1"/>
        <field name="inherit_id" ref="va_mis.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='mis_config_holder']" position="inside">
                <div name="mis_device_sim_recharge">
                    <h2>MIS Sim Recharge</h2>
                    <div class="row mt16 o_settings_container">
                        <div class="col-12 col-lg-6 o_setting_box">
                            <div class="o_setting_right_pane">
                                <span class="o_form_label">Recharge reminder in</span>
                                <div class="text-muted">
                                    Enter the number of days before the recharge expires to receive a reminder
                                </div>
                                <field name="sim_recharge_expiry_days_count" class="mt16 o_light_label" />
                            </div>
                        </div>
                        <div class="col-12 col-lg-6 o_setting_box">
                            <div class="o_setting_right_pane">
                                <span class="o_form_label">Recharge expiry reminder assignees</span>
                                <div class="text-muted">
                                    Select the users who can receive the activity for sim recharge expiry
                                </div>
                                <field name="responsible_sim_assignees" class="mt16 o_light_label" widget="many2many_tags" />
                            </div>
                        </div>
                    </div>
                </div>
            </xpath>
        </field>
    </record>
</odoo>
