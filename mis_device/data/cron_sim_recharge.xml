<odoo>
    <data noupdate="1">
        <record id="sim_recharge_reminder" model="ir.cron">
            <field name="name">MIS Sim: Recharge Reminder</field>
            <field name="model_id" ref="mis_device.model_mis_device_sim"/>
            <field name="user_id" ref="base.user_root"/>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="state">code</field>
            <field name="code">model._send_sim_reminder()</field>
            <field name="active" eval="True"/>
        </record>
    </data>
</odoo>
