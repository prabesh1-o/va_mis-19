<?xml version='1.0' encoding='utf-8'?>
<odoo>

    <record id="hr_attendance_late_view_form" model="ir.ui.view">
        <field name="name">hr.attendance.late.view.form</field>
        <field name="model">hr.attendance.late</field>
        <field name="arch" type="xml">
            <form string="late attendance">
                <sheet>
                    <group>
                        <field name="attendance_id" readonly="1"/>
                        <field name="late_reason" />
                    </group>
                </sheet>
            </form>
        </field>
    </record>
</odoo>
