<?xml version="1.0"?>
<odoo noupdate="1">
	<record forcecreate="True" id="cron_download_data" model="ir.cron">
		<field name="name">Mis Attendance:Download Data</field>
		<field eval="True" name="active"/>
		<field name="user_id" ref="base.user_admin"/>
		<field name="interval_number">10</field>
		<field name="interval_type">minutes</field>
		<field name="model_id" ref="mis_attendance.model_zk_machine"/>
		<field name="state">code</field>
		<field name="code">model.cron_download()</field>
	</record>
	<record forcecreate="True" id="cron_download_today's_attendance_data" model="ir.cron">
		<field name="name">Mis Attendance: Download Today's Attendance Data</field>
		<field eval="True" name="active"/>
		<field name="user_id" ref="base.user_admin"/>
		<field name="interval_number">1</field>
		<field name="interval_type">hours</field>
		<field name="model_id" ref="mis_attendance.model_zk_machine"/>
		<field name="state">code</field>
		<field name="code">model.with_context(is_todays_attendance=True).cron_download()</field>
	</record>
</odoo>
