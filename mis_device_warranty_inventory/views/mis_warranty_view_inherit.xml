<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="mis_device_warranty_inventory_form_view_inherit" model="ir.ui.view">
            <field name="name">mis.device.warranty.form</field>
            <field name="model">mis.warranty</field>
            <field name="inherit_id" ref="mis_warranty.mis_warranty_form"/>
            <field name="arch" type="xml">

                <xpath expr="//form/header" position="inside">
                    <button name="action_return_device"
                            type="object"
                            context="{'is_return': True}"
                            invisible="not is_extracted or stage != 'received' or not new_stock_device_id">
                        Create Return Delivery
                    </button>
                </xpath>

                <xpath expr="//div[@name='button_box']" position="inside">
                    <button name="action_view_delivery"
                            type="object"
                            class="oe_stat_button"
                            icon="fa-truck"
                            invisible="delivery_count == 0">
                        <field name="delivery_count"
                               widget="statinfo"
                               string="Delivery"/>
                    </button>

                    <field name="delivery_count" invisible="1"/>
                </xpath>

                <xpath expr="//field[@name='resolution']" position="after">
                    <field name="new_stock_device_id"
                           domain="[('id', '!=', stock_device_id)]"
                           context="{'active_test': False}"
                           required="resolution == 'replaced'"
                           invisible="resolution != 'replaced'"/>

                    <field name="stock_device_id" invisible="1"/>
                </xpath>

            </field>
        </record>
    </data>
</odoo>