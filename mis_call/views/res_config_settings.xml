<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.mis.call</field>
        <field name="model">res.config.settings</field>
        <field name="priority" eval="100"/>
        <field name="inherit_id" ref="va_mis.res_config_settings_view_form" />
        <field name="arch" type="xml">
            <xpath expr="//div[@name='mis_config_holder']" position="inside">
                <div class="mis_calls">
                    <h2> MIS Call</h2>
                    <div class="row mt16 o_settings_container">
                        <div class="col-12 col-lg-6 o_setting_box">
                            <div class="o_setting_right_pane">
                                <span class="o_form_label">Call model</span>
                                <div class="text-muted">
                                    Select the models from which call is to be created
                                </div>
                                <div class="content-group">
                                    <div class="mt16">
                                        <field name="model_ids" class="o_light_label" widget="many2many_tags"/>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="col-12 col-lg-6 o_setting_box">
                            <div class="o_setting_right_pane">
                                <div class="text-muted">
                                    Click to create server actions for selected models
                                </div>
                                <div class="content-group">
                                    <div class="mt16">
                                        <button name="create_method_server_action" string="Create Assign Call Action" type="object" class="oe_highlight"/>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </xpath>
        </field>
    </record>
</odoo>
