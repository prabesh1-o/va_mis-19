<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record model="ir.module.category" id="mis_assign_call_management">
        <field name="name">MIS Assign Call</field>
        <field name="description">MIS Assign Call</field>
    </record>

    <record id="privilege_mis_assign_call" model="res.groups.privilege">
        <field name="name">MIS Assign Call</field>
        <field name="category_id" ref="mis_assign_call_management"/>
        <field name="sequence">10</field>
    </record>

    <record id="group_able_to_create_assign_call" model="res.groups">
        <field name="name">Assign Call Create</field>
        <field name="comment">
            Users can create assign calls
        </field>
        <field name="privilege_id" ref="privilege_mis_assign_call"/>
        <field name="user_ids" eval="[(4, ref('base.user_admin'))]"/>
    </record>


    <record id="group_able_to_read_assign_call" model="res.groups">
        <field name="name">Able to read assign call</field>
        <field name="comment">Users can read assign call</field>
        <field name="privilege_id" ref="privilege_mis_assign_call"/>
        <field name="user_ids" eval="[(4, ref('base.user_admin'))]"/>
    </record>
    <record id="group_able_to_delete_assign_call" model="res.groups">
        <field name="name">Able to delete assign call</field>
        <field name="comment">Users can delete assign call</field>
       
        <field name="privilege_id" ref="privilege_mis_assign_call"/>
        <field name="user_ids" eval="[(4, ref('base.user_admin'))]"/>
    </record>
    <record id="group_able_to_update_assign_call" model="res.groups">
        <field name="name">Able to update assign call</field>
        <field name="comment">Users can update assign call</field>
       
        <field name="privilege_id" ref="privilege_mis_assign_call"/>
        <field name="user_ids" eval="[(4, ref('base.user_admin'))]"/>
    </record>
    <record id="group_able_to_access_assigned_calls" model="res.groups">    
        <field name="name">Assign Call: Access To Assigned Calls</field>
        <field name="comment">The users can only see their assigned calls</field>
       
        <field name="privilege_id" ref="privilege_mis_assign_call"/>
    </record>
</odoo>
