<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record model="ir.module.category" id="mis_customer_management_parent">
        <field name="name">MIS Customer</field>
        <field name="description">MIS Customer related modules</field>
        <field name="sequence">13</field>
    </record>

    <record model="ir.module.category" id="mis_customer_management">
        <field name="name">MIS Customer</field>
        <field name="description">Mis Customer Access</field>
        <field name="parent_id" ref="mis_customer_management_parent"/>
    </record>

      <record id="privilege_Customer" model="res.groups.privilege">
        <field name="name">Mis Customer</field>
        <field name="sequence">10</field>
        <field name="category_id" ref="mis_customer_management"/>
    </record>

    <!-- User: Own Documents Only -->
    <record id="group_mis_customer_user" model="res.groups">
        <field name="name">User: Read Only</field>
        <field name="privilege_id" ref="mis_customer.privilege_Customer"/>
        <field name="comment">The user will have read only access</field>
    </record>

    <!-- manager: without delete option -->
    <record id="group_mis_customer_manager" model="res.groups">
        <field name="name">Manager</field>
        <field name="privilege_id" ref="mis_customer.privilege_Customer"/>
        <field name="implied_ids"
            eval="[(4, ref('group_mis_customer_user'))]" />
        <field name="comment">The user will have create,read,update access to all records</field>
    </record>

    <!-- admin: all access rights -->
    <record id="group_mis_customer_admin" model="res.groups">
        <field name="name">Administrator</field>
        <field name="privilege_id" ref="mis_customer.privilege_Customer"/>
        <field name="implied_ids"
            eval="[(4, ref('group_mis_customer_manager'))]" />
        <field name="comment">The user will have all access to all records</field>
    </record>
</odoo>
