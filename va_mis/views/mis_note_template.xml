<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <data>
        <record id="mis_note_template_list" model="ir.ui.view">
            <field name="name">mis.note.template.list</field>
            <field name="model">mis.note.template</field>
            <field name="arch" type="xml">
                <list string="Note Templates">
                    <field name="name"/>
                    <field name="note"/>
                </list>
            </field>
        </record>

        <record id="mis_note_template_form" model="ir.ui.view">
            <field name="name">mis.note.template.form</field>
            <field name="model">mis.note.template</field>
            <field name="arch" type="xml">
                <form string="Note Templates">
                    <sheet>
                        <group>
                            <field name="name"/>
                        </group>
                        <field name="note" placeholder="Terms &amp; Conditions"/>
                    </sheet>
                </form>
            </field>
        </record>

        <record model="ir.actions.act_window" id="mis_note_template_menu_action_window">
            <field name="name">Note Templates</field>
            <field name="res_model">mis.note.template</field>
            <field name="view_mode">list,form</field>
        </record>
    </data>
</odoo>
