<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <data>
        <record id="action_customers" model="ir.actions.act_window">
            <field name="name">Customers</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">res.partner</field>
            <field name="view_mode">kanban,list,form,activity</field>
            <field name="search_view_id" ref="base.view_res_partner_filter" />
            <field name="domain">[('is_customer','=',True)]</field>
            <field name="context">{'default_is_customer': True}</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                Create a Customer
                </p>
                <p>
                This helps you track all activities related to your Customers.
                </p>
            </field>
        </record>
        <menuitem id="res_partner_menu_customers" name="Customers" parent="va_mis.mis_root_menu" sequence="5" groups="va_mis.group_mis_admin,va_mis.group_mis_operation,va_mis.group_mis_account,va_mis.group_mis_sales">
            <menuitem id="res_partner_customers_menu" name="Customers" action="action_customers" sequence="1" />
        </menuitem>
    </data>
</odoo>
