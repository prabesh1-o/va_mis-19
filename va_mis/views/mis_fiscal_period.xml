<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="fiscal_period_list" model="ir.ui.view">
            <field name="name">mis.fiscal.period.list</field>
            <field name="model">mis.fiscal.period</field>
            <field name="arch" type="xml">
                <list string="Fiscal Periods">
                    <field name="name"/>
                    <field name="is_active"/>
                    <field name="fiscal_start"/>
                    <field name="fiscal_end"/>
                </list>
            </field>
        </record>

        <record id="fiscal_period_form" model="ir.ui.view">
            <field name="name">mis.fiscal.period.form</field>
            <field name="model">mis.fiscal.period</field>
            <field name="arch" type="xml">
                <form string="Fiscal Periods">
                    <sheet>
                        <group>
                            <field name="name"/>
                            <field name="is_active"/>
                            <field name="fiscal_start"/>
                            <field name="fiscal_end"/>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <record model="ir.actions.act_window" id="fiscal_period_action">
            <field name="name">Fiscal Periods</field>
            <field name="res_model">mis.fiscal.period</field>
            <field name="view_mode">list,form</field>
        </record>
    </data>
</odoo>
