<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record model="ir.module.category" id="mis_fiscal_period">
        <field name="name">MIS Fiscal Period</field>
        <field name="description">Mis Fiscal Period</field>
    </record>

    <record id="privilege_access_fiscal_period" model="res.groups.privilege">
        <field name="name">Fiscal Period</field>
        <field name="sequence">10</field>
        <field name="category_id" ref="va_mis.mis_fiscal_period"/>
    </record>


    <record id="group_able_to_access_fiscal_period" model="res.groups">
        <field name="name">Able to access fiscal period</field>
        <field name="comment">Users can access fiscal period</field>
        <field name="privilege_id" ref = "va_mis.privilege_access_fiscal_period" />
        <field name="user_ids" eval="[(4, ref('base.user_admin'))]"/>
    </record>
</odoo>
