<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record model="ir.module.category" id="mis_user_management">
        <field name="name">MIS Roles</field>
        <field name="description">User access levels</field>
        <field name="sequence">11</field>
    </record>

    <record id="privilege_access_roles" model="res.groups.privilege">
        <field name="name">Mis Roles</field>
        <field name="sequence">10</field>
        <field name="category_id" ref="va_mis.mis_user_management"/>
    </record>



    <record id="group_mis_operation" model="res.groups">
        <field name="name">Operation</field>
        <field name="implied_ids" eval="[(4, ref('va_mis.group_able_to_only_view_records'))]"/>
        <field name="comment">the user will have access related department.</field>
        <field name="privilege_id" ref = "va_mis.privilege_access_roles" />
        <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]" />
    </record>

