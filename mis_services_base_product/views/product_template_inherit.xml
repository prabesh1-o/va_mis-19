<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="product_template_inherit_from_mis_services" model="ir.ui.view">
        <field name="name">product.template.inherit.from.mis_services</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view" />
        <field name="arch" type="xml">
            <data>
                <xpath expr="//div[@name='options']" position="after">
                    <group name="service_menu" class="col-md-6">
                        <field name="service_id" />
                        <field name="service_menu_id" />
                    </group>
                </xpath>
            </data>
        </field>
    </record>
</odoo>
