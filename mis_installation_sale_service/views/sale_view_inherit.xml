<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="mis_installation_sale_service_sale_inherits_sale_order_form_view"
                model="ir.ui.view">
            <field name="name">
                mis.installation.sale.service.inherits.sale.order.form.view
            </field>
            <field name="model">sale.order</field>
            <field name="inherit_id" ref="sale.view_order_form"/>
            <field name="arch" type="xml">

                <!-- Create Installation Order Button -->
                <xpath expr="//button[@name='action_quotation_send']" position="before">
                    <button
                        name="action_create_installation_order"
                        type="object"
                        string="Create Installation Order"
                        class="oe_highlight"
                        confirm="Do you want to create Installation order?"
                        invisible="state != 'sale'"/>
                </xpath>

                <!-- Add helper field -->
                <xpath expr="//field[@name='order_line']/list/field[@name='product_template_id']"
                       position="after">
                    <field name="service_is_installable" column_invisible="1"/>
                </xpath>

                <!-- Make Delivered Qty readonly for installable services -->
                <xpath expr="//field[@name='order_line']/list/field[@name='qty_delivered']"
                       position="attributes">
                    <attribute name="readonly">
                        qty_delivered_method != 'manual' or is_downpayment or service_is_installable
                    </attribute>
                </xpath>

                <!-- Add Cancelled Qty -->
                <xpath expr="//field[@name='order_line']/list/field[@name='qty_delivered']"
                       position="after">
                    <field name="qty_cancelled" optional="hide"/>
                </xpath>

            </field>
        </record>

    </data>
</odoo>