<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="mis_device_warranty_inherits_mis_device_form" model="ir.ui.view">
            <field name="name">mis.device.warranty.inherit.mis_device.form</field>
            <field name="model">mis.device</field>
            <field name="inherit_id" ref="mis_device.mis_device_form"/>
            <field name="arch" type="xml">
                <xpath expr="//div[@name='button_box']" position="inside">
                    <button name="action_view_warranty" type="object" class="oe_stat_button" context="{'xml_id': 'mis_warranty.mis_warranty_action_window'}" icon="fa-file">
                        <field name="warranty_count" widget="statinfo" nolabel="1"/>
                        <div class="o_field_widget o_stat_info">
                            <span class="o_stat_text">Warranty<br></br>Claimed</span>
                        </div>
                    </button>
                </xpath>
                <xpath expr="//field[@name='customer_assigned_ids']" position="after">
                    <field name="warranty_package_id"/>
                    <field name="warranty_expiry_date"/>
                </xpath>
                <xpath expr="//div[@name='button_box']" position="after">
                    <widget name="web_ribbon" bg_color="bg-warning" title="Warranty Return" invisible="not is_warranty_return"/>
                    <widget name="web_ribbon" bg_color="bg-success" title="Warranty Replaced" invisible="not is_warranty_replaced"/>
                    <field name="is_warranty_replaced" invisible="1"/>
                    <field name="is_warranty_return" invisible="1"/>
                </xpath>
            </field>
        </record>
        <record id="mis_device_warranty_inherits_mis_device_list" model="ir.ui.view">
            <field name="name">mis.device.warranty.inherit.mis_device.list</field>
            <field name="model">mis.device</field>
            <field name="inherit_id" ref="mis_device.mis_device_list"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='customer_id']" position="after">
                    <field name="warranty_package_id" optional="hide"/>
                </xpath>
            </field>
        </record>
    </data>
</odoo>
