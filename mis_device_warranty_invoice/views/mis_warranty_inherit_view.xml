<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="mis_device_warranty_invoice_form_view_inherit" model="ir.ui.view">
            <field name="name">mis.device.warranty.invoice.form</field>
            <field name="model">mis.warranty</field>
            <field name="inherit_id" ref="mis_warranty.mis_warranty_form"/>
            <field name="arch" type="xml">

                <!-- Add button in header -->
                <xpath expr="//header" position="inside">
                    <button name="btn_create_invoice"
                            type="object"
                            string="Create Invoice"
                            class="oe_highlight"
                            confirm="Do you want to create an invoice?"
                            invisible="charge == 0"/>

                    <field name="invoice_id" invisible="1"/>
                </xpath>

                <!-- Add smart button -->
                <xpath expr="//div[@name='button_box']" position="inside">
                    <button name="action_view_invoice"
                            type="object"
                            class="oe_stat_button"
                            icon="fa-pencil-square-o"
                            invisible="not invoice_id">
                        <div class="o_field_widget o_stat_info">
                            <span class="o_stat_text">Invoiced</span>
                        </div>
                    </button>
                </xpath>

            </field>
        </record>

    </data>
</odoo>