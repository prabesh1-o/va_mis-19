<odoo>
    <data>
        <record id='mis_manufacturer_tree_view' model='ir.ui.view'>
            <field name="name">mis.manufacturer.list</field>
            <field name="model">mis.manufacturer</field>
            <field name="arch" type="xml">
                <list string="Manufacturer" export_xlsx="false">
                    <field name="name" />
                    <field name="address" />
                    <field name="contact_no" />
                    <field name="email" />
                    <field name="website" />
                    <field name="state" />
                </list>
            </field>
        </record>

        <record id='mis_manufacturer_view_form' model='ir.ui.view'>
            <field name="name">mis.manufacturer.form</field>
            <field name="model">mis.manufacturer</field>
            <field name="arch" type="xml">
                <form string="Manufacturer">
                    <header>
                        <field name="state" widget="statusbar" options="{'clickable': 1}"/>
                    </header>
                    <sheet>
                        <group>
                                <field name="name" />
                                <field name="address" />
                                <field name="contact_no" />
                                <field name="email" widget="email"/>
                                <field name="website" />
                        </group>
                    </sheet>
                    <chatter>
                        <field name="message_follower_ids" groups="base.group_user"/>
                        <field name="activity_ids"/>
                        <field name="message_ids"/>
                    </chatter>
                </form>
            </field>
        </record>

        <record id="mis_manufacturer_search" model="ir.ui.view">
            <field name="name">mis.manufacturer.search</field>
            <field name="model">mis.manufacturer</field>
            <field name="arch" type="xml">
                <search>
                    <field name="name" string="Manufacturer"/>
                    <field name="address" string="Address"/>
                    <field name="contact_no" string="Contact"/>
                    <filter name="state" string="Active Manufacturer" domain="[('state','=','active')]" />
                    <filter name="state" string="Inactive Manufacturer" domain="[('state','=','inactive')]" />
                    
                    <filter name="group_state" string="Status" context="{'group_by': 'state'}" />
                    
                </search>
            </field>
        </record>

        <record model="ir.actions.act_window" id="mis_manufacturer_action">
            <field name="name">Manufacturer</field>
            <field name="res_model">mis.manufacturer</field>
            <field name="view_mode">list,form</field>
        </record>
        <menuitem id="mis_manufacturer_menu" name="Manufacturer" action="mis_manufacturer_action" parent="mis_product_parent_menu" sequence="2" />
    </data>
</odoo>
